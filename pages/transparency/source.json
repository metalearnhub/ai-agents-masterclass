lineHeight": "1.18", "textAlign": "left", "top": 105, "width": 640}}, "mobile": {"styles": {"color": "rgba(26,26,26,1)", "fontSize": 30, "fontWeight": "800", "height": 41, "left": 20, "lineHeight": "1.18", "textAlign": "left", "top": 84, "width": 380}}}}, {"id": "t_2111", "type": "text-block", "specials": {"text": "IRD Digital Marketing Services is registered with the Bureau of Internal Revenue of the Philippines."}, "responsive": {"desktop": {"styles": {"color": "rgba(85,85,85,1)", "fontSize": 21, "fontWeight": "400", "height": 67, "left": 160, "lineHeight": "1.5", "textAlign": "left", "top": 178, "width": 640}}, "mobile": {"styles": {"color": "rgba(85,85,85,1)", "fontSize": 18, "fontWeight": "400", "height": 85, "left": 20, "lineHeight": "1.5", "textAlign": "left", "top": 139, "width": 380}}}}, {"id": "t_2112", "type": "text-block", "specials": {"text": "Last updated October 24, 2026"}, "responsive": {"desktop": {"styles": {"color": "rgba(120,120,120,1)", "fontSize": 14, "fontWeight": "400", "height": 25, "left": 160, "lineHeight": "1.5", "textAlign": "left", "top": 263, "width": 640}}, "mobile": {"styles": {"color": "rgba(120,120,120,1)", "fontSize": 13, "fontWeight": "400", "height": 24, "left": 20, "lineHeight": "1.5", "textAlign": "left", "top": 238, "width": 380}}}}, {"id": "eb_2120", "type": "editor-blog", "specials": {"html": "<div class='dd-article'>\n<p>IRD Digital Marketing Services, the consultancy behind Chatbot Authority and this website, has been registered with the Bureau of Internal Revenue (BIR) of the Philippines since 2019. As BIR requires for businesses with an online presence, our Registration Seal is displayed below. Scan the QR code to verify it.</p>\n<figure class='dd-fig' style='max-width:440px;margin:8px auto 26px auto'><div class='dd-shot' style='aspect-ratio:1/1;background:#ffffff;border:1px solid #e3e8ee'><img src='https://statics.pancake.vn/web-media-264/70/49/8e/e3/e5a0f26e3a46a214b80db0572ea41164480a1fabb80d367f0b323f42.jpg' alt='BIR Registration Seal of IRD Digital Marketing Services, registered with the Bureau of Internal Revenue in 2019, with a QR code to verify the registration' width='1080' height='1080' loading='lazy'></div>\n<figcaption>BIR Registration Seal. Tap to enlarge, then scan the QR code to verify.</figcaption>\n</figure>\n<div class='dd-table-wrap'><table>\n<tbody>\n<tr><td><b>Registered business</b></td><td>IRD Digital Marketing Services</td></tr>\n<tr><td><b>Brands</b></td><td>Chatbot Authority, Dijae Dadula</td></tr>\n<tr><td><b>Registered with</b></td><td>Bureau of Internal Revenue, Philippines</td></tr>\n<tr><td><b>Registered since</b></td><td>2019</td></tr>\n<tr><td><b>Location</b></td><td>Bacoor City, Cavite, Philippines</td></tr>\n<tr><td><b>Verify</b></td><td>Scan the QR code on the seal above</td></tr>\n</tbody>\n</table></div>\n<h2 id='what'>What this means for you</h2>\n<p>When you work with us, you are working with a legitimate, tax-compliant business: official receipts, proper documentation and no shortcuts.</p>\n<p>Questions about our services? <a href='https://www.dijaedadula.com/book'>Book a free AI Automation Blueprint call</a> or see the done-for-you services at <a href='https://ird.dijaedadula.com/'>IRD Digital Marketing Services</a>.</p>\n</div>\n"}, "responsive": {"desktop": {"styles": {"height": 1227, "left": 160, "top": 320, "width": 640}}, "mobile": {"styles": {"height": 1431, "left": 20, "top": 290, "width": 380}}}}, {"id": "h_css2121", "type": "html-box", "specials": {"html": "&lt;style&gt;.dd-article ul{list-style:disc outside !important}.dd-article ol{list-style:decimal outside !important}.dd-article li{display:list-item !important}.dd-article ul ul{list-style:circle outside !important}&lt;/style&gt;"}, "responsive": {"desktop": {"styles": {"height": 1, "left": 160, "top": 1594, "width": 1}}, "mobile": {"styles": {"height": 1, "left": 20, "top": 1760, "width": 1}}}}]}, {"id": "sec_2149", "type": "section", "responsive": {"desktop": {"styles": {"bac