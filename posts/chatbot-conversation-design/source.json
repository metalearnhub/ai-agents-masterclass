{"cartConfigs":{"isActive":false},"dynamic_pages":[],"options":{"mobileOnly":false,"versionID":null},"page":[{"id":"sec_2101","type":"section","responsive":{"desktop":{"styles":{"background":"rgba(255,255,255,1)","height":72}},"mobile":{"styles":{"background":"rgba(255,255,255,1)","height":66}}},"children":[{"id":"t_2102","type":"text-block","specials":{"text":"<a href=\"https://www.dijaedadula.com/home\" style=\"color:rgba(26,26,26,1);text-decoration:none\">DIJAE DADULA</a>"},"responsive":{"desktop":{"styles":{"color":"rgba(26,26,26,1)","fontSize":16,"fontWeight":"800","height":24,"left":160,"letterSpacing":"3px","lineHeight":"1.4","top":26,"width":260}},"mobile":{"styles":{"color":"rgba(26,26,26,1)","fontSize":14,"fontWeight":"800","height":22,"left":20,"letterSpacing":"2px","lineHeight":"1.4","top":22}}}},{"id":"b_2103","type":"button","specials":{"text":"Subscribe"},"events":[{"action":"open_link","id":"ev_2104","target":"https://grow.dijaedadula.com/newsletter","targetURL":"_self","type":"click"}],"responsive":{"desktop":{"styles":{"background":"rgba(0,122,102,1)","borderRadius":"8px","color":"rgba(255,255,255,1)","fontSize":15,"fontWeight":"700","height":40,"left":650,"textAlign":"center","top":16}},"mobile":{"styles":{"background":"rgba(0,122,102,1)","borderRadius":"8px","color":"rgba(255,255,255,1)","fontSize":14,"fontWeight":"700","height":38,"left":270,"textAlign":"center","top":14,"width":130}}}},{"id":"n_2105","type":"text-block","specials":{"text":"<a href=\"https://grow.dijaedadula.com/newsletter\" style=\"color:rgba(26,26,26,1);text-decoration:none\">Newsletter</a>"},"responsive":{"desktop":{"styles":{"color":"rgba(26,26,26,1)","fontSize":15,"fontWeight":"500","height":24,"left":532,"lineHeight":"1.4","textAlign":"center","top":26,"width":110}},"mobile":{"config":{"hide":true},"styles":{"color":"rgba(26,26,26,1)","fontSize":14,"height":22,"left":270,"lineHeight":"1.4","textAlign":"center","top":22,"width":130}}}},{"id":"n_2106","type":"text-block","specials":{"text":"<a href=\"https://www.dijaedadula.com/blog\" style=\"color:rgba(26,26,26,1);text-decoration:none\">Blog</a>"},"responsive":{"desktop":{"styles":{"color":"rgba(26,26,26,1)","fontSize":15,"fontWeight":"500","height":24,"left":414,"lineHeight":"1.4","textAlign":"center","top":26,"width":110}},"mobile":{"config":{"hide":true},"styles":{"color":"rgba(26,26,26,1)","fontSize":14,"height":22,"left":270,"lineHeight":"1.4","textAlign":"center","top":22,"width":130}}}},{"id":"l_2107","type":"line","responsive":{"desktop":{"styles":{"borderColor":"rgba(230,232,236,1)","left":0,"top":63,"width":960}},"mobile":{"styles":{"borderColor":"rgba(230,232,236,1)","left":0,"top":60,"width":420}}}}]},{"id":"sec_2108","type":"section","responsive":{"desktop":{"styles":{"background":"rgba(255,255,255,1)","height":9542}},"mobile":{"styles":{"background":"rgba(255,255,255,1)","height":12486}}},"children":[{"id":"t_2109","type":"text-block","specials":{"text":"<a href=\"https://www.dijaedadula.com/blog\" style=\"color:rgba(0,122,102,1);text-decoration:underline\">Blog</a> · CRM and automation that sells"},"responsive":{"desktop":{"styles":{"color":"rgba(120,120,120,1)","fontSize":14,"fontWeight":"400","height":25,"left":160,"lineHeight":"1.5","textAlign":"left","top":64,"width":640}},"mobile":{"styles":{"color":"rgba(120,120,120,1)","fontSize":13,"fontWeight":"400","height":24,"left":20,"lineHeight":"1.5","textAlign":"left","top":48,"width":380}}}},{"id":"t_2110","type":"text-block","specials":{"tag":"h1","text":"Chatbot Conversation Design That Converts: Openers, Quick Replies and Follow-Ups"},"responsive":{"desktop":{"styles":{"color":"rgba(26,26,26,1)","fontSize":42,"fontWeight":"800","height":154,"left":160,"lineHeight":"1.18","textAlign":"left","top":105,"width":640}},"mobile":{"styles":{"color":"rgba(26,26,26,1)","fontSize":30,"fontWeight":"800","height":147,"left":20,"lineHeight":"1.18","textAlign":"left","top":84,"width":380}}}},{"id":"t_2111","type":"text-block","specials":{"text":"How to write the first message, offer the right taps and follow up inside Messenger's rules, with copy-ready scripts, two sketches and a test checklist."},"responsive":{"desktop":{"styles":{"color":"rgba(85,85,85,1)","fontSize":21,"fontWeight":"400","height":98,"left":160,"lineHeight":"1.5","textAlign":"left","top":277,"width":640}},"mobile":{"styles":{"color":"rgba(85,85,85,1)","fontSize":18,"fontWeight":"400","height":112,"left":20,"lineHeight":"1.5","textAlign":"left","top":245,"width":380}}}},{"id":"t_2112","type":"text-block","specials":{"text":"By <a href=\"https://www.dijaedadula.com/home\" style=\"color:rgba(0,122,102,1);text-decoration:underline\">Dijae Dadula</a> · November 3, 2026 · 10 min read"},"responsive":{"desktop":{"styles":{"color":"rgba(120,120,120,1)","fontSize":14,"fontWeight":"400","height":25,"left":160,"lineHeight":"1.5","textAlign":"left","top":393,"width":640}},"mobile":{"styles":{"color":"rgba(120,120,120,1)","fontSize":13,"fontWeight":"400","height":24,"left":20,"lineHeight":"1.5","textAlign":"left","top":371,"width":380}}}},{"id":"eb_2120","type":"editor-blog","specials":{"html":"<div class='dd-article dd-c'>\n<figure class='dd-fig'><div class='dd-shot' style='aspect-ratio:16/9'><img src='https://statics.pancake.vn/web-media-264/b9/a6/09/04/2fbae3c07780cd70b8f2e48afb09c86c43d46b011884e4e3f2df9258.png' alt='Paper-cut illustration of a phone showing a friendly chat bubble with three tap buttons, a dotted path leading to a calendar with a check mark and a handshake, and a small clock' width='1536' height='864' loading='lazy'></div></figure>\n<div class='dd-scene'><span class='dd-note-label'>Picture this · illustrative</span>\n<p>Someone taps “Send message” on your Facebook ad. The bot answers in one second: “Hi! How can I help you?” Then nothing. The customer stares at an empty text box, is not sure what to type, and goes back to scrolling. The bot was fast. It just gave them nothing to do.</p></div>\n<p class='dd-plain'>Chatbot conversation design means <mark>deciding what the bot says, which taps it offers and when it follows up, so every message moves the customer one step closer to a decision.</mark></p>\n<div class='dd-words'><span><b>Opener</b> the first message a customer sees</span><span><b>Quick reply</b> a tap-to-answer chip that disappears after use</span><span><b>Button</b> a tap option that stays on the message</span><span><b>24-hour window</b> the time you can message freely after a customer writes</span><span><b>Follow-up</b> a nudge when the customer goes quiet</span></div>\n<p>This guide is for business owners, marketers and agencies running a chatbot on Messenger or Instagram, usually with <a href='https://www.dijaedadula.com/botcake' rel='sponsored nofollow'>Botcake</a> or <a href='https://manychat.partnerlinks.io/rozuomtj4677' rel='sponsored nofollow'>ManyChat</a> (affiliate links). You will get a copy-ready opener, rules for quick replies, follow-ups that respect Meta's rules and a short test to prove it works.</p>\n<nav class='dd-toc' aria-label='Table of contents'>\n<p class='dd-toc-title'>Questions in this guide</p>\n<ol>\n<li><a href='#opener'>What should the first message say?</a></li>\n<li><a href='#quick-replies'>How many quick replies should you offer?</a></li>\n<li><a href='#which-tap'>Quick reply, button or free text?</a></li>\n<li><a href='#qualify'>How many questions before the offer?</a></li>\n<li><a href='#follow-up'>How do you follow up without annoying people?</a></li>\n<li><a href='#try'>What can you set up today?</a></li>\n<li><a href='#faq'>FAQ</a></li>\n</ol>\n</nav>\n<h2 id='opener'>What should a chatbot's first message say?</h2>\n<p class='dd-short'><b>Short answer:</b> who is talking, what it can do right now, and two to four taps for the most common reasons people message you.</p>\n<p>“How can I help you?” feels polite, but it hands the hardest job to the customer: working out what to ask and how to phrase it. A good opener does that work for them. It names the assistant honestly, lists what it can do in one line, and offers taps that match the top reasons people message your page. One tap is always a way to reach a person.</p>\n<p>Where do the taps come from? Your own inbox. Read the last 50 to 100 first messages on your page and group them. For most shops it is price, stock and delivery. For clinics it is booking and prices. For service businesses it is “how much” and “can you do this for me”. Those groups become your taps.</p>\n<figure class='dd-fig'>\n<svg viewBox='0 0 640 300' role='img' aria-labelledby='sc1t sc1d' xmlns='http://www.w3.org/2000/svg'>\n<title id='sc1t'>Before and after: rewriting a chatbot opener</title>\n<desc id='sc1d'>Two hand-drawn phone sketches. Left, labelled before: one bubble that says Hi! How can I help you? and an empty space, with a handwritten note saying the customer has to guess. Right, labelled after: a bubble introducing the assistant and what it can do, followed by three tap options, Prices and stock, Book a visit, and Talk to a person, with a note saying one tap starts the conversation.</desc>\n<defs><pattern id='sc1g' width='16' height='16' patternUnits='userSpaceOnUse'><circle cx='2' cy='2' r='1' fill='#e6dccb'/></pattern></defs>\n<rect x='0' y='0' width='640' height='300' rx='14' fill='#fbf7f0'/>\n<rect x='0' y='0' width='640' height='300' rx='14' fill='url(#sc1g)'/>\n<text x='40' y='36' class='svg-hand'>before</text>\n<rect x='30' y='48' width='250' height='220' rx='22' fill='#fff' stroke='#5b6470' stroke-width='2.5' stroke-dasharray='8 7'/>\n<rect x='50' y='70' width='190' height='40' rx='16' fill='#f6f8fa' stroke='#5b6470' stroke-width='2'/>\n<text x='64' y='95' class='svg-t'>Hi! How can I help you?</text>\n<text x='70' y='170' class='svg-hand'>customer has to guess...</text>\n<text x='360' y='36' class='svg-hand'>after</text>\n<rect x='350' y='48' width='260' height='220' rx='22' fill='#fff' stroke='#007a66' stroke-width='2.5'/>\n<rect x='366' y='64' width='228' height='58' rx='16' fill='#e8f4f1' stroke='#007a66' stroke-width='2'/>\n<text x='378' y='86' class='svg-s'>Hi, I'm the shop's assistant. I can</text>\n<text x='378' y='106' class='svg-s'>check prices, stock and bookings.</text>\n<rect x='366' y='136' width='150' height='30' rx='15' fill='#fff' stroke='#007a66' stroke-width='2'/><text x='382' y='156' class='svg-t'>Prices and stock</text>\n<rect x='366' y='174' width='130' height='30' rx='15' fill='#fff' stroke='#007a66' stroke-width='2'/><text x='382' y='194' class='svg-t'>Book a visit</text>\n<rect x='366' y='212' width='150' height='30' rx='15' fill='#fff' stroke='#c2410c' stroke-width='2'/><text x='382' y='232' class='svg-t'>Talk to a person</text>\n<rect x='420' y='276' width='190' height='20' rx='4' fill='#ffd8bf' opacity='0.7'/><text x='428' y='291' class='svg-hand'>one tap starts it</text>\n</svg>\n<figcaption><b>Sketch 1.</b> The same greeting, rewritten. The “after” version tells people what the bot can do and gives them a first step they can take with one tap.</figcaption>\n</figure>\n<p>Here is an opener you can adapt. Every line is a template, not a real conversation:</p>\n<div class='dd-code'><button class='dd-copy' type='button'>Copy</button><pre><code>Hi {first_name}, I'm the {business} assistant.\nI can check prices and stock, book a visit, or connect you with our team.\nWhat would you like to do?\n\n[Prices and stock]  [Book a visit]  [Talk to a person]</code></pre></div>\n<h2 id='quick-replies'>How many quick replies should you offer?</h2>\n<p class='dd-short'><b>Short answer:</b> three to five, with short labels, even though Messenger allows more.</p>\n<p>Messenger allows up to 13 quick replies on one message, and a text quick reply title can be up to 20 characters. Quick replies are also temporary: they disappear when the customer taps one and after the next message, so they suit one-time choices, not menus people return to. For reference, check the documentation <a href='https://developers.facebook.com/documentation/business-messaging/messenger-platform/send-messages/quick-replies' target='_blank' rel='noopener'>here</a>.</p>\n<p>The limit is not the target. On a phone, five chips already wrap into rows, and every extra option is one more thing to read before the customer can act. Keep labels to two or three words, start with a verb or a noun the customer would use (“Prices”, “Book a visit”), and keep “Talk to a person” in the set.</p>\n<div class='dd-myth'>\n<div class='dd-m'><span class='dd-lab'>Myth</span><p>More options make the bot more helpful.</p></div>\n<div class='dd-r'><span class='dd-lab'>Reality</span><p>More options make the first step harder. Cover the top reasons people message you, and let free text and a person handle the rest.</p></div>\n</div>\n<h2 id='which-tap'>Quick reply, button or free text: which one when?</h2>\n<p class='dd-short'><b>Short answer:</b> quick replies for one-time choices, buttons for actions people may come back to, free text when the answer cannot fit in a tap.</p>\n<div class='dd-table-wrap'><table>\n<thead><tr><th>Use</th><th>When</th><th>Example</th></tr></thead>\n<tbody>\n<tr><td>Quick replies</td><td>A single choice that moves the conversation forward</td><td>“Which branch is closest to you?”</td></tr>\n<tr><td>Buttons</td><td>An action that should stay visible on the message (a link, a call, a booking page)</td><td>“See the price list”, “Call us”</td></tr>\n<tr><td>Free text</td><td>Details that vary for every customer, or anything an AI agent should read in the customer's own words</td><td>“Describe the problem with your unit”</td></tr>\n<tr><td>Input fields</td><td>A value you want to save to the contact record</td><td>Phone number, email, preferred date</td></tr>\n</tbody>\n</table></div>\n<p>If an AI agent handles the conversation, free text stops being a dead end, because the agent can read the customer's own words. Taps still matter: they are faster for the customer and they give the agent a clean signal of intent. The voice of those replies is its own topic, covered in <a href='https://www.dijaedadula.com/chatbot-sound-human'>how to make your chatbot sound human</a>.</p>\n<h2 id='qualify'>How many questions should a bot ask before the offer?</h2>\n<p class='dd-short'><b>Short answer:</b> only the questions your team needs to act, usually two or three, asked one at a time.</p>\n<p>Every question should earn its place by changing what happens next: which product, which branch, how soon. If the answer would not change the reply or the routing, cut the question. Ask one thing per message, explain why when it is not obvious (“so I can check stock at the nearest branch”), and give the customer something useful right after they answer. The full method for scoring and routing those answers is in <a href='https://www.dijaedadula.com/qualify-leads-messenger-automatically'>how to qualify leads in Messenger automatically</a>.</p>\n<figure class='dd-fig'>\n<svg viewBox='0 0 640 260' role='img' aria-labelledby='sc2t sc2d' xmlns='http://www.w3.org/2000/svg'>\n<title id='sc2t'>The conversation path, sketched</title>\n<desc id='sc2d'>A hand-drawn dashed path runs from an opener bubble on the left through three stops: one tap, two short questions, and an offer or booking. It ends at a handshake labelled person. A side note says a stuck or upset customer jumps straight to a person, and another note says a reply resets the follow-up timer.</desc>\n<defs><pattern id='sc2g' width='16' height='16' patternUnits='userSpaceOnUse'><circle cx='2' cy='2' r='1' fill='#e6dccb'/></pattern></defs>\n<rect x='0' y='0' width='640' height='260' rx='14' fill='#fbf7f0'/>\n<rect x='0' y='0' width='640' height='260' rx='14' fill='url(#sc2g)'/>\n<path d='M90 150 C 150 80, 190 80, 230 120 S 320 190, 380 130 S 470 70, 540 130' fill='none' stroke='#007a66' stroke-width='3' stroke-dasharray='8 7' stroke-linecap='round'/>\n<rect x='24' y='128' width='84' height='44' rx='18' fill='#fff' stroke='#007a66' stroke-width='2.5'/><text x='38' y='156' class='svg-t'>Opener</text>\n<circle cx='190' cy='86' r='11' fill='#fff' stroke='#007a66' stroke-width='2.5'/><text x='160' y='62' class='svg-hand'>one tap</text>\n<circle cx='320' cy='176' r='11' fill='#fff' stroke='#007a66' stroke-width='2.5'/><text x='340' y='182' class='svg-hand'>two short questions</text>\n<circle cx='450' cy='86' r='11' fill='#fff' stroke='#c2410c' stroke-width='2.5'/><text x='400' y='62' class='svg-hand'>offer or booking</text>\n<rect x='520' y='108' width='96' height='44' rx='18' fill='#e8f4f1' stroke='#007a66' stroke-width='2.5'/><text x='536' y='136' class='svg-t'>Person</text>\n<path d='M66 176 C 120 240, 470 250, 560 156' fill='none' stroke='#c2410c' stroke-width='2.5' stroke-dasharray='4 6' stroke-linecap='round'/>\n<rect x='190' y='226' width='250' height='24' rx='4' fill='#ffd8bf' opacity='0.7'/><text x='198' y='244' class='svg-hand'>stuck or upset? straight to a person</text>\n<text x='24' y='32' class='svg-hand'>a reply resets the follow-up timer</text>\n</svg>\n<figcaption><b>Sketch 2.</b> A short path from opener to decision, with an exit to a person at every step. The handoff rules are in <a href='https://www.dijaedadula.com/ai-chatbot-human-handoff'>the handoff playbook</a>.</figcaption>\n</figure>\n<h2 id='follow-up'>How do you follow up without annoying people?</h2>\n<p class='dd-short'><b>Short answer:</b> one or two useful nudges inside the 24-hour window, each with a new reason to reply, and stop the moment the customer answers.</p>\n<p>On Messenger, a business can reply freely for 24 hours after the customer's last message. Outside that window the options are narrow, and they narrowed further in 2026: Meta retired the POST_PURCHASE_UPDATE, CONFIRMED_EVENT_UPDATE and ACCOUNT_UPDATE message tags. The HUMAN_AGENT tag still lets a real person reply to a customer within 7 days, for genuine support cases, not mass messages. For order and shipping updates Meta points to utility message templates, and promotional messages go through opt-in marketing messages. For reference, check the summary of the change <a href='https://community.manychat.com/product-updates/meta-s-deprecation-of-the-message-tags-feature-on-messenger-9010' target='_blank' rel='noopener'>here</a>.</p>\n<p>So design your follow-ups to work inside the window. In Botcake AI, the agent's AI response behavior tab has an Auto follow-up switch that sends follow-ups when the customer has not replied, with a delay (“Send follow-up messages automatically after”) and a cap (“Number of messages”). You can let the AI write them or write them yourself. For flow-based bots, tag-based sequences do the same job: attach a sequence when a tag is added and remove it when the customer replies. For reference, check the documentation <a href='https://docs.pancake.biz/botcake/st-f5/st-p2?lang=en' target='_blank' rel='noopener'>here</a>.</p>\n<figure class='dd-fig'><div class='dd-shot'><img src='https://statics.pancake.vn/web-media-264/8c/e7/aa/3c/bd689be48f6a418ed3c5ced51d7defc73fb892853dfad7c22ad688d5.webp' alt='Botcake AI response behavior tab showing the Auto follow-up switch, a delay of 30 minutes, 3 follow-up messages and the option to create follow-up messages automatically with AI or manually' loading='lazy'></div><figcaption><b>Screenshot.</b> Botcake AI's Auto follow-up settings in a demo setup: a 30-minute delay and a cap of 3 messages. Pick values that fit your own sales cycle.</figcaption></figure>\n<p>What makes a follow-up welcome is the reason it gives. “Just checking in” adds nothing. An illustrative nudge like “The size you asked about is back in stock” or “Here is the price list you asked for” gives the customer a reason to answer. Each nudge should carry one new, useful thing and one easy tap. The longer-term follow-up system, including what happens after the window closes, is in <a href='https://www.dijaedadula.com/automate-lead-follow-up'>how to automate lead follow-up with AI</a>.</p>\n<div class='dd-myth'>\n<div class='dd-m'><span class='dd-lab'>Myth</span><p>If the customer stops replying, the bot should keep messaging until they answer.</p></div>\n<div class='dd-r'><span class='dd-lab'>Reality</span><p>Messenger's rules limit what you can send after 24 hours, and silence is often an answer. Two useful nudges, then let a person decide.</p></div>\n</div>\n<div class='dd-sticky'><span class='dd-note-label'>Dijae's rule</span><p>Every bot message should end with one easy next step. If the customer has to work out what to type, the conversation is already leaking.</p></div>\n<h2 id='try'>What can you set up today?</h2>\n<ol class='dd-try'>\n<li>Read your last 50 to 100 first messages and group them into the top three reasons people write.</li>\n<li>Rewrite your opener: who is talking, what it can do, three taps that match those reasons, plus “Talk to a person”.</li>\n<li>Trim every quick reply set to five options or fewer, with labels well under 20 characters.</li>\n<li>Cut every qualifying question that would not change the reply or the routing.</li>\n<li>Set follow-ups inside the 24-hour window, each with a new reason to reply, and stop on any reply.</li>\n</ol>\n<p><b>How you will know it works</b> (track these weekly, before and after the change):</p>\n<div class='dd-table-wrap'><table>\n<thead><tr><th>Metric</th><th>What it tells you</th><th>Pass when</th></tr></thead>\n<tbody>\n<tr><td>Opener tap rate</td><td>Share of new conversations where the customer taps or types after the first message</td><td>Higher than before the rewrite</td></tr>\n<tr><td>First-message drop-off</td><td>Conversations that end right after the opener</td><td>Lower than before</td></tr>\n<tr><td>Qualified conversations per 100</td><td>Conversations that reach the offer or booking step</td><td>Higher, with no rise in complaints</td></tr>\n<tr><td>Follow-up reply rate</td><td>Share of follow-ups that get an answer</td><td>Stable or higher; any rise in blocks or “stop” replies means cut back</td></tr>\n<tr><td>Time to a person</td><td>Minutes from “Talk to a person” to a human reply</td><td>Within your stated hours</td></tr>\n</tbody>\n</table></div>\n<p>Before you switch the new flow on, run it through the test cases in <a href='https://www.dijaedadula.com/how-to-test-an-ai-chatbot'>how to test an AI chatbot</a>: every tap, every dead end, an upset customer and a customer who only types.</p>\n<p>An honest limitation: a better script cannot fix a weak offer, wrong prices in the bot's knowledge or a team that takes hours to answer a handoff. Conversation design makes the path clear; the offer and the people behind it still decide the sale.</p>\n<h2 id='faq'>Frequently asked questions</h2>\n<h3>What is chatbot conversation design?</h3>\n<p>It is planning what a chatbot says, which options it offers and when it follows up, so each message helps the customer take the next step. It covers the opener, quick replies and buttons, qualifying questions, follow-ups and the handoff to a person.</p>\n<h3>How many quick replies can a Messenger message have?</h3>\n<p>Messenger allows up to 13 quick replies per message, with titles of up to 20 characters. For most businesses, three to five short options convert better than a long list.</p>\n<h3>Can a chatbot message customers after 24 hours?</h3>\n<p>Only in limited cases. In 2026 Meta retired several Messenger message tags; a real person can still reply within 7 days using the HUMAN_AGENT tag, order updates move to utility templates and promotions need opt-in marketing messages. Plan routine follow-ups inside the 24-hour window.</p>\n<h3>What is a good chatbot opener example?</h3>\n<p>“Hi, I'm the shop's assistant. I can check prices and stock, book a visit, or connect you with our team. What would you like to do?” followed by three taps that match those options.</p>\n<div class='dd-cta'>\n<p class='dd-cta-title'>Build a conversation that moves people forward</p>\n<p>Run Messenger automation and your AI agent on <a href='https://www.dijaedadula.com/botcake' rel='sponsored nofollow'>Botcake</a> with your team inbox on <a href='https://www.dijaedadula.com/pancake' rel='sponsored nofollow'>Pancake</a>. Use coupon <b>CHAMP20</b> for 20% off all Pancake plans plus 30 days free (new Pancake customers or a new billing account). For Instagram-first brands, <a href='https://manychat.partnerlinks.io/rozuomtj4677' rel='sponsored nofollow'>ManyChat</a>. These are affiliate links.</p>\n<p>Want your opener, flows and follow-ups designed and tested for you? <a href='https://www.dijaedadula.com/book'>Book a free AI Automation Blueprint call</a>. Prefer to learn it step by step? <a href='https://grow.dijaedadula.com/newsletter'>Join the free weekly newsletter</a>.</p>\n</div>\n<h2>References</h2>\n<ol class='dd-refs'>\n<li><a href='https://developers.facebook.com/documentation/business-messaging/messenger-platform/send-messages/quick-replies' target='_blank' rel='noopener'>Meta for Developers: Quick replies (Messenger Platform)</a>. Up to 13 quick replies, 20-character titles. Accessed November 2026.</li>\n<li><a href='https://community.manychat.com/product-updates/meta-s-deprecation-of-the-message-tags-feature-on-messenger-9010' target='_blank' rel='noopener'>ManyChat Community: Meta's deprecation of the Message Tags feature on Messenger</a> (HUMAN_AGENT unaffected; utility messages as the replacement), February 2026.</li>\n<li><a href='https://www.broadturbo.com/en/messenger-rules/message-tags' target='_blank' rel='noopener'>BroadTurbo: Which Facebook Message Tags were retired? 2026 update</a> (retired tags, HUMAN_AGENT 7-day window). Accessed November 2026.</li>\n<li><a href='https://docs.pancake.biz/botcake/st-f5/st-p2?lang=en' target='_blank' rel='noopener'>Botcake documentation: customer tags and sequences</a>.</li>\n<li><a href='https://www.dijaedadula.com/botcake-ai-pancake-setup-guide'>Botcake AI + Pancake Setup Guide</a> (the full agent setup, including Auto follow-up).</li>\n</ol>\n<h2>Keep reading</h2>\n<ul class='dd-more'>\n<li><a href='https://www.dijaedadula.com/qualify-leads-messenger-automatically'>How to Qualify Leads in Messenger Automatically (Without Annoying Your Customers)</a></li>\n<li><a href='https://www.dijaedadula.com/chatbot-sound-human'>How to Make Your Chatbot Sound Human, Not Robotic</a></li>\n<li><a href='https://www.dijaedadula.com/ai-chatbot-human-handoff'>When Should an AI Chatbot Hand Off to a Human? A Handoff Playbook</a></li>\n<li><a href='https://www.dijaedadula.com/blog'>See all posts on the blog</a></li>\n</ul>\n</div>\n"},"responsive":{"desktop":{"styles":{"height":9035,"left":160,"top":450,"width":640}},"mobile":{"styles":{"height":12014,"left":20,"top":423,"width":380}}}},{"id":"h_css2121","type":"html-box","specials":{"html":"&lt;style&gt;.dd-article ul{list-style:disc outside !important}.dd-article ol{list-style:decimal outside !important}.dd-article li{display:list-item !important}.dd-article ul ul{list-style:circle outside !important}&lt;/style&gt;"},"responsive":{"desktop":{"styles":{"height":1,"left":160,"top":9532,"width":1}},"mobile":{"styles":{"height":1,"left":20,"top":12476,"width":1}}}}]},{"id":"sec_2141","type":"section","responsive":{"desktop":{"styles":{"background":"rgba(247,248,250,1)","height":402}},"mobile":{"styles":{"background":"rgba(247,248,250,1)","height":508}}},"children":[{"id":"t_2142","type":"text-block","specials":{"tag":"h2","text":"Get one practical idea like this every week"},"responsive":{"desktop":{"styles":{"color":"rgba(26,26,26,1)","fontSize":26,"fontWeight":"800","height":69,"left":160,"lineHeight":"1.25","textAlign":"left","top":56,"width":640}},"mobile":{"styles":{"color":"rgba(26,26,26,1)","fontSize":22,"fontWeight":"800","height":59,"left":20,"lineHeight":"1.25","textAlign":"left","top":40,"width":380}}}},{"id":"t_2143","type":"text-block","specials":{"text":"Join the free newsletter on AI agents, automation and turning your skills into income. Prefer