{"cartConfigs":{"isActive":false},"dynamic_pages":[],"options":{"mobileOnly":false,"versionID":null},"page":[{"id":"sec_2101","type":"section","responsive":{"desktop":{"styles":{"background":"rgba(255,255,255,1)","height":72}},"mobile":{"styles":{"background":"rgba(255,255,255,1)","height":66}}},"children":[{"id":"t_2102","type":"text-block","specials":{"text":"<a href=\"https://www.dijaedadula.com/home\" style=\"color:rgba(26,26,26,1);text-decoration:none\">DIJAE DADULA</a>"},"responsive":{"desktop":{"styles":{"color":"rgba(26,26,26,1)","fontSize":16,"fontWeight":"800","height":24,"left":160,"letterSpacing":"3px","lineHeight":"1.4","top":26,"width":260}},"mobile":{"styles":{"color":"rgba(26,26,26,1)","fontSize":14,"fontWeight":"800","height":22,"left":20,"letterSpacing":"2px","lineHeight":"1.4","top":22}}}},{"id":"b_2103","type":"button","specials":{"text":"Subscribe"},"events":[{"action":"open_link","id":"ev_2104","target":"https://grow.dijaedadula.com/newsletter","targetURL":"_self","type":"click"}],"responsive":{"desktop":{"styles":{"background":"rgba(0,122,102,1)","borderRadius":"8px","color":"rgba(255,255,255,1)","fontSize":15,"fontWeight":"700","height":40,"left":650,"textAlign":"center","top":16}},"mobile":{"styles":{"background":"rgba(0,122,102,1)","borderRadius":"8px","color":"rgba(255,255,255,1)","fontSize":14,"fontWeight":"700","height":38,"left":270,"textAlign":"center","top":14,"width":130}}}},{"id":"n_2105","type":"text-block","specials":{"text":"<a href=\"https://grow.dijaedadula.com/newsletter\" style=\"color:rgba(26,26,26,1);text-decoration:none\">Newsletter</a>"},"responsive":{"desktop":{"styles":{"color":"rgba(26,26,26,1)","fontSize":15,"fontWeight":"500","height":24,"left":532,"lineHeight":"1.4","textAlign":"center","top":26,"width":110}},"mobile":{"config":{"hide":true},"styles":{"color":"rgba(26,26,26,1)","fontSize":14,"height":22,"left":270,"lineHeight":"1.4","textAlign":"center","top":22,"width":130}}}},{"id":"n_2106","type":"text-block","specials":{"text":"<a href=\"https://www.dijaedadula.com/blog\" style=\"color:rgba(26,26,26,1);text-decoration:none\">Blog</a>"},"responsive":{"desktop":{"styles":{"color":"rgba(26,26,26,1)","fontSize":15,"fontWeight":"500","height":24,"left":414,"lineHeight":"1.4","textAlign":"center","top":26,"width":110}},"mobile":{"config":{"hide":true},"styles":{"color":"rgba(26,26,26,1)","fontSize":14,"height":22,"left":270,"lineHeight":"1.4","textAlign":"center","top":22,"width":130}}}},{"id":"l_2107","type":"line","responsive":{"desktop":{"styles":{"borderColor":"rgba(230,232,236,1)","left":0,"top":63,"width":960}},"mobile":{"styles":{"borderColor":"rgba(230,232,236,1)","left":0,"top":60,"width":420}}}}]},{"id":"sec_2108","type":"section","responsive":{"desktop":{"styles":{"background":"rgba(255,255,255,1)","height":7760}},"mobile":{"styles":{"background":"rgba(255,255,255,1)","height":10797}}},"children":[{"id":"t_2109","type":"text-block","specials":{"text":"<a href=\"https://www.dijaedadula.com/blog\" style=\"color:rgba(0,122,102,1);text-decoration:underline\">Blog</a> · CRM and automation that sells"},"responsive":{"desktop":{"styles":{"color":"rgba(120,120,120,1)","fontSize":14,"fontWeight":"400","height":25,"left":160,"lineHeight":"1.5","textAlign":"left","top":64,"width":640}},"mobile":{"styles":{"color":"rgba(120,120,120,1)","fontSize":13,"fontWeight":"400","height":24,"left":20,"lineHeight":"1.5","textAlign":"left","top":48,"width":380}}}},{"id":"t_2110","type":"text-block","specials":{"tag":"h1","text":"Email, Messenger, SMS or WhatsApp: Choosing the Right Channel for Automated Follow-Up"},"responsive":{"desktop":{"styles":{"color":"rgba(26,26,26,1)","fontSize":42,"fontWeight":"800","height":204,"left":160,"lineHeight":"1.18","textAlign":"left","top":105,"width":640}},"mobile":{"styles":{"color":"rgba(26,26,26,1)","fontSize":30,"fontWeight":"800","height":147,"left":20,"lineHeight":"1.18","textAlign":"left","top":84,"width":380}}}},{"id":"t_2111","type":"text-block","specials":{"text":"An executive brief on the four follow-up channels: the rules that decide when you can message, what each one costs, which messages belong where, and how to measure it."},"responsive":{"desktop":{"styles":{"color":"rgba(85,85,85,1)","fontSize":21,"fontWeight":"400","height":98,"left":160,"lineHeight":"1.5","textAlign":"left","top":327,"width":640}},"mobile":{"styles":{"color":"rgba(85,85,85,1)","fontSize":18,"fontWeight":"400","height":139,"left":20,"lineHeight":"1.5","textAlign":"left","top":245,"width":380}}}},{"id":"t_2112","type":"text-block","specials":{"text":"By <a href=\"https://www.dijaedadula.com/home\" style=\"color:rgba(0,122,102,1);text-decoration:underline\">Dijae Dadula</a> · November 10, 2026 · 7 min read"},"responsive":{"desktop":{"styles":{"color":"rgba(120,120,120,1)","fontSize":14,"fontWeight":"400","height":25,"left":160,"lineHeight":"1.5","textAlign":"left","top":443,"width":640}},"mobile":{"styles":{"color":"rgba(120,120,120,1)","fontSize":13,"fontWeight":"400","height":24,"left":20,"lineHeight":"1.5","textAlign":"left","top":398,"width":380}}}},{"id":"eb_2120","type":"editor-blog","specials":{"html":"<div class='dd-article dd-b'>\n<figure class='dd-fig'><div class='dd-shot' style='aspect-ratio:16/9'><img src='https://statics.pancake.vn/web-media-264/b1/50/16/3b/28bedee6d66f86ab8bc9101d89ef2d65c1de8135c737a7bc34ff0081.png' alt='Isometric illustration of a control hub routing message tiles along four tracks to an envelope, a chat bubble, a phone with a text bubble and a chat bubble with a phone handset, with one track highlighted orange' width='1536' height='864' loading='lazy'></div></figure>\n<div class='dd-brief'>\n<p class='dd-brief-title'>The 60-second brief</p>\n<ol>\n<li>No single channel wins. Each one has its own rule for when you are allowed to message, its own consent requirement and its own cost model.</li>\n<li>Messenger and WhatsApp are strongest inside the 24 hours after the customer last wrote. Email and SMS reach people later, but only with consent and proper sender setup.</li>\n<li>The best follow-up starts on the channel the customer chose, then moves to an owned channel, with permission, for the longer sequence.</li>\n</ol>\n<p class='dd-decision'>Decision: reply where the conversation started, ask for permission to continue elsewhere, and match each message type to the channel built for it.</p>\n</div>\n<div class='dd-tiles'>\n<div class='dd-tile'><b>24 hrs</b><span>standard window to message freely on Messenger and WhatsApp after the customer's last message</span></div>\n<div class='dd-tile'><b>0.3%</b><span>spam-rate ceiling Gmail sets for senders, alongside SPF, DKIM, DMARC and one-click unsubscribe</span></div>\n<div class='dd-tile'><b>1,000</b><span>free WhatsApp service messages per business number each month, from October 1, 2026</span></div>\n</div>\n<p>This brief is for business owners, marketers and the agencies that set up follow-up for them. It compares the four channels on the rules that matter, then gives a five-move plan for choosing and measuring.</p>\n<nav class='dd-toc' aria-label='Table of contents'>\n<p class='dd-toc-title'>In this brief</p>\n<ol>\n<li><a href='#start'>Move 01: Start where the customer started</a></li>\n<li><a href='#rules'>Move 02: Know each channel's rules</a></li>\n<li><a href='#match'>Move 03: Match the message to the channel</a></li>\n<li><a href='#sequence'>Move 04: Build a cross-channel sequence</a></li>\n<li><a href='#measure'>Move 05: Measure by channel</a></li>\n<li><a href='#faq'>FAQ</a></li>\n</ol>\n</nav>\n<p class='dd-kicker'>Move 01 · Reply</p>\n<h2 id='start'>Start where the customer started</h2>\n<div class='dd-move'>\n<div><span class='dd-lab'>What</span><p>Answer on the channel the customer used, while their window is open.</p></div>\n<div><span class='dd-lab'>Why it matters</span><p>That is where they are waiting, and where your reply costs least.</p></div>\n<div><span class='dd-lab'>Do this</span><p>Make the first reply instant and useful, then ask how they prefer to hear from you next.</p></div>\n</div>\n<p>A customer who messages your Facebook Page is already in Messenger. Moving them to email in the first reply adds friction for no gain. On Messenger, a business can message freely for 24 hours after the customer's last message, and up to 7 days when the conversation started from a Click-to-Messenger ad. WhatsApp works the same way: a 24-hour customer service window opens each time the customer writes. Inside those windows, follow-up is easy. After them, the rules tighten. The speed side is in <a href='https://www.dijaedadula.com/lead-response-time'>lead response time</a>.</p>\n<p class='dd-kicker'>Move 02 · Rules</p>\n<h2 id='rules'>Know each channel's rules before you automate</h2>\n<div class='dd-move'>\n<div><span class='dd-lab'>What</span><p>Each channel decides when you may message, with what consent, at what cost.</p></div>\n<div><span class='dd-lab'>Why it matters</span><p>Breaking a rule gets messages blocked, filtered as spam or accounts restricted.</p></div>\n<div><span class='dd-lab'>Do this</span><p>Write the rule for each channel into your automation before the first sequence goes live.</p></div>\n</div>\n<div class='dd-table-wrap'><table>\n<thead><tr><th>Channel</th><th>When you can message</th><th>Permission and setup</th><th>Cost model</th></tr></thead>\n<tbody>\n<tr><td>Messenger</td><td>Freely for 24 hours after the customer's last message (7 days after a Click-to-Messenger ad). After that, only approved utility templates, the human-agent tag, or paid marketing and sponsored messages</td><td>The customer starts the conversation; marketing messages need opt-in</td><td>Replies in the window are free; marketing and sponsored messages are paid</td></tr>\n<tr><td>WhatsApp</td><td>Freely for 24 hours after the customer writes. After that, approved templates only</td><td>Opt-in for business-initiated templates</td><td>Per message by category (marketing, utility, authentication) since July 1, 2025. From October 1, 2026, service messages beyond 1,000 a month and utility templates in the window are charged too</td></tr>\n<tr><td>Email</td><td>Any time, with consent</td><td>Gmail requires SPF, DKIM and DMARC, one-click unsubscribe and a spam rate below 0.3%</td><td>Low per message; the cost is list care and deliverability</td></tr>\n<tr><td>SMS (US)</td><td>Any time, with consent and quiet-hours care</td><td>Business numbers must be registered for 10DLC; unregistered traffic is blocked since February 1, 2025</td><td>Per message plus registration and carrier fees</td></tr>\n</tbody>\n</table></div>\n<p>The Messenger detail, including the retired message tags and the newer utility and marketing messages, is in <a href='https://www.dijaedadula.com/chatbot-conversation-design'>chatbot conversation design</a>. For reference, check the Messenger documentation <a href='https://developers.facebook.com/documentation/business-messaging/messenger-platform/send-messages' target='_blank' rel='noopener'>here</a>. Rules and prices change often, especially on WhatsApp, so re-check them before every new build.</p>\n<p class='dd-kicker'>Move 03 · Match</p>\n<h2 id='match'>Match the message to the channel</h2>\n<div class='dd-move'>\n<div><span class='dd-lab'>What</span><p>Decide channel by message type, not by habit.</p></div>\n<div><span class='dd-lab'>Why it matters</span><p>A reminder belongs where it is seen in minutes; a guide belongs where it can be kept.</p></div>\n<div><span class='dd-lab'>Do this</span><p>Map your five most common follow-up messages to a primary and a backup channel.</p></div>\n</div>\n<figure class='dd-fig'>\n<svg viewBox='0 0 640 316' role='img' aria-labelledby='sb1t sb1d' xmlns='http://www.w3.org/2000/svg'>\n<title id='sb1t'>Which channel fits which follow-up message</title>\n<desc id='sb1d'>A grid with five message types as rows (instant reply to an inquiry, appointment reminder, order or booking update, promotion or offer, long guide or resource) and four channels as columns (Messenger, WhatsApp, Email, SMS). Filled teal squares mark the best fit, outlined squares a workable fit, and dashes a poor fit. Instant replies fit Messenger and WhatsApp best. Reminders fit SMS and WhatsApp. Updates fit WhatsApp and email. Promotions fit email best. Long guides fit email.</desc>\n<rect x='0' y='0' width='640' height='316' fill='#ffffff'/>\n<text x='24' y='28' class='svg-ax'>EXHIBIT · CHANNEL FIT BY MESSAGE TYPE (RECOMMENDED)</text>\n<text x='327' y='60' text-anchor='middle' class='svg-ax'>MESSENGER</text><text x='425' y='60' text-anchor='middle' class='svg-ax'>WHATSAPP</text><text x='519' y='60' text-anchor='middle' class='svg-ax'>EMAIL</text><text x='589' y='60' text-anchor='middle' class='svg-ax'>SMS</text>\n<line x1='24' y1='72' x2='616' y2='72' stroke='#14181c' stroke-width='1.5'/>\n<text x='24' y='98' class='svg-num'>Instant reply to an inquiry</text>\n<rect x='318' y='84' width='18' height='18' fill='#007a66'/><rect x='416' y='84' width='18' height='18' fill='#007a66'/><rect x='510' y='84' width='18' height='18' fill='none' stroke='#007a66' stroke-width='2'/><text x='584' y='98' class='svg-ax'>–</text>\n<line x1='24' y1='114' x2='616' y2='114' stroke='#e3e8ee'/>\n<text x='24' y='140' class='svg-num'>Appointment reminder</text>\n<rect x='318' y='126' width='18' height='18' fill='none' stroke='#007a66' stroke-width='2'/><rect x='416' y='126' width='18' height='18' fill='#007a66'/><rect x='510' y='126' width='18' height='18' fill='none' stroke='#007a66' stroke-width='2'/><rect x='580' y='126' width='18' height='18' fill='#c2410c'/>\n<line x1='24' y1='156' x2='616' y2='156' stroke='#e3e8ee'/>\n<text x='24' y='182' class='svg-num'>Order or booking update</text>\n<rect x='318' y='168' width='18' height='18' fill='none' stroke='#007a66' stroke-width='2'/><rect x='416' y='168' width='18' height='18' fill='#007a66'/><rect x='510' y='168' width='18' height='18' fill='#007a66'/><rect x='580' y='168' width='18' height='18' fill='none' stroke='#007a66' stroke-width='2'/>\n<line x1='24' y1='198' x2='616' y2='198' stroke='#e3e8ee'/>\n<text x='24' y='224' class='svg-num'>Promotion or offer</text>\n<rect x='318' y='210' width='18' height='18' fill='none' stroke='#007a66' stroke-width='2'/><rect x='416' y='210' width='18' height='18' fill='none' stroke='#007a66' stroke-width='2'/><rect x='510' y='210' width='18' height='18' fill='#007a66'/><text x='584' y='224' class='svg-ax'>–</text>\n<line x1='24' y1='240' x2='616' y2='240' stroke='#e3e8ee'/>\n<text x='24' y='266' class='svg-num'>Long guide or resource</text>\n<text x='322' y='266' class='svg-ax'>–</text><text x='420' y='266' class='svg-ax'>–</text><rect x='510' y='252' width='18' height='18' fill='#007a66'/><text x='584' y='266' class='svg-ax'>–</text>\n<text x='24' y='306' class='svg-ax'>FILLED = BEST FIT · OUTLINE = WORKABLE · DASH = POOR FIT</text>\n</svg>\n<figcaption><b>Exhibit 1.</b> A recommended fit for each message type. Promotions on Messenger and WhatsApp are workable only through paid, opted-in marketing messages.</figcaption>\n</figure>\n<p>Use this as a starting map, then adjust for your market. The orange square marks the one place SMS clearly earns its cost: short, time-critical reminders to people who opted in.</p>\n<p class='dd-kicker'>Move 04 · Sequence</p>\n<h2 id='sequence'>Build a cross-channel sequence, with permission</h2>\n<div class='dd-move'>\n<div><span class='dd-lab'>What</span><p>A follow-up plan that starts in chat and continues on an owned channel.</p></div>\n<div><span class='dd-lab'>Why it matters</span><p>Chat windows close; a buyer who needs a week to decide still needs your follow-up.</p></div>\n<div><span class='dd-lab'>Do this</span><p>Ask for email or phone consent inside the window, with a clear reason.</p></div>\n</div>\n<figure class='dd-fig'>\n<svg viewBox='0 0 640 230' role='img' aria-labelledby='sb2t sb2d' xmlns='http://www.w3.org/2000/svg'>\n<title id='sb2t'>A follow-up sequence across channels</title>\n<desc id='sb2d'>A timeline from minute zero to day seven. At minute zero, an instant reply in the same chat channel. Within 24 hours, chat follow-ups and a request for email or phone consent, highlighted orange. On day 1, a confirmation by email. On day 3, a useful resource by email. On day 7, a last call by email or an SMS reminder if the customer opted in.</desc>\n<rect x='0' y='0' width='640' height='230' fill='#ffffff'/>\n<text x='24' y='28' class='svg-ax'>EXHIBIT · ONE SEQUENCE, TWO CHANNELS (ILLUSTRATIVE)</text>\n<line x1='50' y1='120' x2='600' y2='120' stroke='#14181c' stroke-width='2'/>\n<circle cx='60' cy='120' r='8' fill='#007a66'/><text x='40' y='94' class='svg-num'>Reply</text><text x='40' y='150' class='svg-ax'>0 MIN</text><text x='40' y='168' class='svg-ax'>CHAT</text>\n<circle cx='190' cy='120' r='9' fill='#c2410c'/><text x='150' y='80' class='svg-num'>Ask consent</text><line x1='190' y1='86' x2='190' y2='110' stroke='#c2410c'/><text x='168' y='150' class='svg-ax'>&lt;24 HRS</text><text x='172' y='168' class='svg-ax'>CHAT</text>\n<circle cx='320' cy='120' r='8' fill='#007a66'/><text x='290' y='94' class='svg-num'>Confirm</text><text x='300' y='150' class='svg-ax'>DAY 1</text><text x='298' y='168' class='svg-ax'>EMAIL</text>\n<circle cx='450' cy='120' r='8' fill='#007a66'/><text x='418' y='94' class='svg-num'>Resource</text><text x='430' y='150' class='svg-ax'>DAY 3</text><text x='428' y='168' class='svg-ax'>EMAIL</text>\n<circle cx='580' cy='120' r='8' fill='#007a66'/><text x='544' y='94' class='svg-num'>Last call</text><text x='560' y='150' class='svg-ax'>DAY 7</text><text x='532' y='168' class='svg-ax'>EMAIL / SMS</text>\n<text x='24' y='214' class='svg-ax'>ANY REPLY STOPS THE SEQUENCE AND HANDS THE LEAD TO A PERSON</text>\n</svg>\n<figcaption><b>Exhibit 2.</b> An illustrative sequence. The orange step, asking for permission while the chat window is open, is what makes the rest possible.</figcaption>\n</figure>\n<p>Keep the consent request honest and specific: “Can I email you the price list and check in on Thursday?” works better than a generic form. In the Philippines, record that consent; the steps are in <a href='https://www.dijaedadula.com/data-privacy-act-chatbots-philippines'>the Data Privacy Act guide for chatbots</a>. The follow-up messages themselves are in <a href='https://www.dijaedadula.com/automate-lead-follow-up'>how to automate lead follow-up</a>.</p>\n<div class='dd-bottom'><span class='dd-note-label'>Dijae's rule</span><p>Follow up where the conversation lives. Move it to another channel only with the customer's permission and a reason they would agree with.</p></div>\n<p class='dd-kicker'>Move 05 · Measure</p>\n<h2 id='measure'>Measure each channel on what it costs to move a lead</h2>\n<div class='dd-move'>\n<div><span class='dd-lab'>What</span><p>Three numbers per channel, reviewed monthly.</p></div>\n<div><span class='dd-lab'>Why it matters</span><p>A cheap channel that nobody reads is the most expensive one.</p></div>\n<div><span class='dd-lab'>Do this</span><p>Tag every follow-up with its channel so the numbers separate cleanly.</p></div>\n</div>\n<p><b>Success metric:</b> cost per booked call (or per order) by channel, next to reply rate and opt-out or block rate. Keep a channel when it books at a cost you accept and its opt-outs stay flat.</p>\n<div class='dd-table-wrap'><table class='dd-check'>\n<thead><tr><th></th><th>Launch checklist for a new follow-up channel</th></tr></thead>\n<tbody>\n<tr><td></td><td>The channel's messaging window and consent rule are written into the automation</td></tr>\n<tr><td></td><td>Email: SPF, DKIM and DMARC pass; one-click unsubscribe works</td></tr>\n<tr><td></td><td>SMS (US): number registered for 10DLC; opt-out keywords honored</td></tr>\n<tr><td></td><td>WhatsApp: templates approved; cost per message category checked for your countries</td></tr>\n<tr><td></td><td>Any reply stops the sequence and alerts a person</td></tr>\n<tr><td></td><td>Every message is tagged by channel for reporting</td></tr>\n</tbody>\n</table></div>\n<p>An honest limitation: this brief covers the general rules for Messenger, WhatsApp, Gmail and US SMS. It does not cover every country's SMS and consent law, and WhatsApp prices change by country and quarter. Check the current rules for your markets before you commit a budget.</p>\n<h2 id='faq'>Frequently asked questions</h2>\n<h3>What is the best channel for customer follow-up?</h3>\n<p>The one the customer used first, for the first replies. For longer follow-up, email works for most businesses because it allows messages at any time with consent; SMS and WhatsApp suit short, time-critical reminders.</p>\n<h3>Can I follow up on Messenger after 24 hours?</h3>\n<p>Only in limited ways: approved utility messages for transactional updates, the human-agent tag for a person replying within 7 days, or paid marketing and sponsored messages. Promotional follow-up outside the window needs opt-in or ads.</p>\n<h3>Is WhatsApp follow-up free?</h3>\n<p>Not entirely. WhatsApp charges per message by category since July 1, 2025. From October 1, 2026, each business number gets 1,000 free service messages a month, and utility templates inside the 24-hour window are charged.</p>\n<h3>Do I need to register to send business SMS in the US?</h3>\n<p>Yes. Application-to-person texts from standard 10-digit numbers must be registered for 10DLC, and unregistered traffic has been blocked since February 1, 2025.</p>\n<div class='dd-cta'>\n<p class='dd-cta-title'>Plan your follow-up channels</p>\n<p>Want instant replies in chat and a permission-based follow-up sequence set up for your business? <a href='https://www.dijaedadula.com/book'>Book a free AI Automation Blueprint call</a>. Tools that fit this well: <a href='https://www.dijaedadula.com/botcake' rel='sponsored nofollow'>Botcake</a> for Messenger and <a href='https://www.gohighlevel.com/?fp_ref=dijae-044b83' rel='sponsored nofollow'>GoHighLevel</a> for email and SMS sequences (affiliate links: I may earn a commission at no extra cost to you).</p>\n<p>Prefer to learn it step by step? <a href='https://grow.dijaedadula.com/newsletter'>Join the free weekly newsletter</a>.</p>\n</div>\n<h2>References</h2>\n<ol class='dd-refs'>\n<li><a href='https://developers.facebook.com/documentation/business-messaging/messenger-platform/send-messages' target='_blank' rel='noopener'>Meta: Messenger Platform, sending messages</a> (24-hour standard messaging window and exceptions). Checked November 2026.</li>\n<li><a href='https://help.zoho.com/portal/en/community/topic/whatsapp-pricing-changes-pay-per-message-starting-july-1-2025' target='_blank' rel='noopener'>Zoho: WhatsApp pricing changes, pay per message from July 1, 2025</a>.</li>\n<li><a href='https://respond.io/blog/whatsapp-pricing-change-2026' target='_blank' rel='noopener'>respond.io: WhatsApp pricing change, October 1, 2026</a>, and <a href='https://help.sleekflow.io/en_US/whatsapp/pricing' target='_blank' rel='noopener'>SleekFlow: WhatsApp Business API pricing</a>.</li>\n<li><a href='https://ppc.land/google-updates-requirements-for-bulk-email-senders-to-gmail/' target='_blank' rel='noopener'>PPC Land: Google's requirements for bulk email senders to Gmail</a> (effective February 1, 2024).</li>\n<li><a href='https://community.freepbx.org/t/reminder-unregistered-10dlc-to-be-blocked-as-of-feb-1st-2025/103057' target='_blank' rel='noopener'>FreePBX community: unregistered 10DLC traffic blocked from February 1, 2025</a>.</li>\n</ol>\n<h2>Keep reading</h2>\n<ul class='dd-more'>\n<li><a href='https://www.dijaedadula.com/automate-lead-follow-up'>How to Automate Lead Follow-Up With AI (Without Sounding Like a Robot)</a></li>\n<li><a href='https://www.dijaedadula.com/chatbot-conversation-design'>Chatbot Conversation Design That Converts: Openers, Quick Replies and Follow-Ups</a></li>\n<li><a href='https://www.dijaedadula.com/lead-response-time'>Lead Response Time: Why the First Five Minutes Decide Who Wins the Customer</a></li>\n<li><a href='https://www.dijaedadula.com/blog'>See all posts on the blog</a></li>\n</ul>\n</div>\n"},"responsive":{"desktop":{"styles":{"height":7203,"left":160,"top":500,"width":640}},"mobile":{"styles":{"height":10298,"left":20,"top":450,"width":380}}}},{"id":"h_css2121","type":"html-box","specials":{"html":"&lt;style&gt;.dd-article ul{list-style:disc outside !important}.dd-article ol{list-style:decimal outside !important}.dd-article li{display:list-item !important}.dd-article ul ul{list-style:circle outside !important}&lt;/style&gt;"},"responsive":{"desktop":{"styles":{"height":1,"left":160,"top":7750,"width":1}},"mobile":{"styles":{"height":1,"left":20,"top":10787,"width":1}}}}]},{"id":"sec_2141","type":"section","responsive":{"desktop":{"styles":{"background":"rgba(247,248,250,1)","height":402}},"mobile":{"styles":{"background":"rgba(247,248,250,1)","height":508}}},"children":[{"id":"t_2142","type":"text-block","specials":{"tag":"h2","text":"Get one practical idea like this every week"},"responsive":{"desktop":{"styles":{"color":"rgba(26,26,26,1)","fontSize":26,"fontWeight":"800","height":69,"left":160,"lineHeight":"1.25","textAlign":"left","top":56,"width":640}},"mobile":{"styles":{"color":"rgba(26,26,26,1)","fontSize":22,"fontWeight":"800","height":59,"left":20,"lineHeight":"1.25","textAlign":"left","top":40,"width":380}}}},{"id":"t_2143","type":"text-block","specials":{"text":"Join the free newsletter on AI agents, automation and turning your skills into income. Prefer video? Watch the walkthroughs on <a href=\"https://www.youtube.com/c/DijaeDadulaPRO\" style=\"color:rgba(0,122,102,1);text-decoration:underline\">YouTube</a>."},"responsive":{"desktop":{"styles":{"color":"rgba(85,85,85,1)","fontSize":17,"fontWeight":"400","height":59,"left":160,"lineHeight":"1.6","textAlign":"left","top":137,"width":640}},"mobile":{"styles":{"color":"rgba(85,85,85,1)","fontSize":16,"fontWe