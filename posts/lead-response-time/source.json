{"cartConfigs":{"isActive":false},"dynamic_pages":[],"options":{"mobileOnly":false,"versionID":null},"page":[{"id":"sec_2101","type":"section","responsive":{"desktop":{"styles":{"background":"rgba(255,255,255,1)","height":72}},"mobile":{"styles":{"background":"rgba(255,255,255,1)","height":66}}},"children":[{"id":"t_2102","type":"text-block","specials":{"text":"<a href=\"https://www.dijaedadula.com/home\" style=\"color:rgba(26,26,26,1);text-decoration:none\">DIJAE DADULA</a>"},"responsive":{"desktop":{"styles":{"color":"rgba(26,26,26,1)","fontSize":16,"fontWeight":"800","height":24,"left":160,"letterSpacing":"3px","lineHeight":"1.4","top":26,"width":260}},"mobile":{"styles":{"color":"rgba(26,26,26,1)","fontSize":14,"fontWeight":"800","height":22,"left":20,"letterSpacing":"2px","lineHeight":"1.4","top":22}}}},{"id":"b_2103","type":"button","specials":{"text":"Subscribe"},"events":[{"action":"open_link","id":"ev_2104","target":"https://grow.dijaedadula.com/newsletter","targetURL":"_self","type":"click"}],"responsive":{"desktop":{"styles":{"background":"rgba(0,122,102,1)","borderRadius":"8px","color":"rgba(255,255,255,1)","fontSize":15,"fontWeight":"700","height":40,"left":650,"textAlign":"center","top":16}},"mobile":{"styles":{"background":"rgba(0,122,102,1)","borderRadius":"8px","color":"rgba(255,255,255,1)","fontSize":14,"fontWeight":"700","height":38,"left":270,"textAlign":"center","top":14,"width":130}}}},{"id":"n_2105","type":"text-block","specials":{"text":"<a href=\"https://grow.dijaedadula.com/newsletter\" style=\"color:rgba(26,26,26,1);text-decoration:none\">Newsletter</a>"},"responsive":{"desktop":{"styles":{"color":"rgba(26,26,26,1)","fontSize":15,"fontWeight":"500","height":24,"left":532,"lineHeight":"1.4","textAlign":"center","top":26,"width":110}},"mobile":{"config":{"hide":true},"styles":{"color":"rgba(26,26,26,1)","fontSize":14,"height":22,"left":270,"lineHeight":"1.4","textAlign":"center","top":22,"width":130}}}},{"id":"n_2106","type":"text-block","specials":{"text":"<a href=\"https://www.dijaedadula.com/blog\" style=\"color:rgba(26,26,26,1);text-decoration:none\">Blog</a>"},"responsive":{"desktop":{"styles":{"color":"rgba(26,26,26,1)","fontSize":15,"fontWeight":"500","height":24,"left":414,"lineHeight":"1.4","textAlign":"center","top":26,"width":110}},"mobile":{"config":{"hide":true},"styles":{"color":"rgba(26,26,26,1)","fontSize":14,"height":22,"left":270,"lineHeight":"1.4","textAlign":"center","top":22,"width":130}}}},{"id":"l_2107","type":"line","responsive":{"desktop":{"styles":{"borderColor":"rgba(230,232,236,1)","left":0,"top":63,"width":960}},"mobile":{"styles":{"borderColor":"rgba(230,232,236,1)","left":0,"top":60,"width":420}}}}]},{"id":"sec_2108","type":"section","responsive":{"desktop":{"styles":{"background":"rgba(255,255,255,1)","height":7067}},"mobile":{"styles":{"background":"rgba(255,255,255,1)","height":9912}}},"children":[{"id":"t_2109","type":"text-block","specials":{"text":"<a href=\"https://www.dijaedadula.com/blog\" style=\"color:rgba(0,122,102,1);text-decoration:underline\">Blog</a> · CRM and automation that sells"},"responsive":{"desktop":{"styles":{"color":"rgba(120,120,120,1)","fontSize":14,"fontWeight":"400","height":25,"left":160,"lineHeight":"1.5","textAlign":"left","top":64,"width":640}},"mobile":{"styles":{"color":"rgba(120,120,120,1)","fontSize":13,"fontWeight":"400","height":24,"left":20,"lineHeight":"1.5","textAlign":"left","top":48,"width":380}}}},{"id":"t_2110","type":"text-block","specials":{"tag":"h1","text":"Lead Response Time: Why the First Five Minutes Decide Who Wins the Customer"},"responsive":{"desktop":{"styles":{"color":"rgba(26,26,26,1)","fontSize":42,"fontWeight":"800","height":154,"left":160,"lineHeight":"1.18","textAlign":"left","top":105,"width":640}},"mobile":{"styles":{"color":"rgba(26,26,26,1)","fontSize":30,"fontWeight":"800","height":147,"left":20,"lineHeight":"1.18","textAlign":"left","top":84,"width":380}}}},{"id":"t_2111","type":"text-block","specials":{"text":"An executive brief on speed to lead: what the research shows, why most businesses are slow, and the five moves that get every lead a useful reply in minutes."},"responsive":{"desktop":{"styles":{"color":"rgba(85,85,85,1)","fontSize":21,"fontWeight":"400","height":98,"left":160,"lineHeight":"1.5","textAlign":"left","top":277,"width":640}},"mobile":{"styles":{"color":"rgba(85,85,85,1)","fontSize":18,"fontWeight":"400","height":112,"left":20,"lineHeight":"1.5","textAlign":"left","top":245,"width":380}}}},{"id":"t_2112","type":"text-block","specials":{"text":"By <a href=\"https://www.dijaedadula.com/home\" style=\"color:rgba(0,122,102,1);text-decoration:underline\">Dijae Dadula</a> · November 5, 2026 · 7 min read"},"responsive":{"desktop":{"styles":{"color":"rgba(120,120,120,1)","fontSize":14,"fontWeight":"400","height":25,"left":160,"lineHeight":"1.5","textAlign":"left","top":393,"width":640}},"mobile":{"styles":{"color":"rgba(120,120,120,1)","fontSize":13,"fontWeight":"400","height":24,"left":20,"lineHeight":"1.5","textAlign":"left","top":371,"width":380}}}},{"id":"eb_2120","type":"editor-blog","specials":{"html":"<div class='dd-article dd-b'>\n<figure class='dd-fig'><div class='dd-shot' style='aspect-ratio:16/9'><img src='https://statics.pancake.vn/web-media-264/71/d2/32/1e/4554a9d54070ab0b9df1705468da226d672f0fbce55412695d7b1582.png' alt='Isometric illustration of a stopwatch beside a conveyor of message tiles moving into a teal inbox, with one orange message arriving first and a dashboard showing a falling line' width='1536' height='864' loading='lazy'></div></figure>\n<div class='dd-brief'>\n<p class='dd-brief-title'>The 60-second brief</p>\n<ol>\n<li>Research going back nearly two decades points the same way: the odds of reaching and qualifying a lead fall fast after the first few minutes.</li>\n<li>Most businesses are still slow. A 2026 test of 114 B2B companies found an average email reply time of almost 12 hours.</li>\n<li>The fix is a system, not effort: an instant useful reply, fast routing to a person, and cover for nights and weekends.</li>\n</ol>\n<p class='dd-decision'>Decision: make the first reply automatic and useful, and make one named person own every qualified lead within the hour.</p>\n</div>\n<div class='dd-tiles'>\n<div class='dd-tile'><b>21×</b><span>lower odds of qualifying a lead at 30 minutes than at 5 minutes (MIT and InsideSales study, 2007)</span></div>\n<div class='dd-tile'><b>42 hrs</b><span>average response time to a web lead among 2,241 US companies (HBR study, 2011)</span></div>\n<div class='dd-tile'><b>1 of 114</b><span>B2B companies sent a personal email reply within 5 minutes (Workato test, 2026)</span></div>\n</div>\n<p>This brief is for business owners, sales leaders and marketers who pay for leads and want more of them to turn into conversations. It covers what the research says, why speed slips, and five moves to fix it.</p>\n<nav class='dd-toc' aria-label='Table of contents'>\n<p class='dd-toc-title'>In this brief</p>\n<ol>\n<li><a href='#evidence'>Move 01: Know what speed is worth</a></li>\n<li><a href='#measure'>Move 02: Measure your real response time</a></li>\n<li><a href='#instant'>Move 03: Make the first reply instant</a></li>\n<li><a href='#route'>Move 04: Route hot leads to a person</a></li>\n<li><a href='#prove'>Move 05: Cover the off-hours and prove it</a></li>\n<li><a href='#faq'>FAQ</a></li>\n</ol>\n</nav>\n<p class='dd-kicker'>Move 01 · Understand</p>\n<h2 id='evidence'>Know what speed is worth</h2>\n<div class='dd-move'>\n<div><span class='dd-lab'>What</span><p>Two widely cited studies measured what happens as response time grows.</p></div>\n<div><span class='dd-lab'>Why it matters</span><p>Interest is highest the moment someone reaches out, and it fades fast.</p></div>\n<div><span class='dd-lab'>Do this</span><p>Treat response time as a revenue number, not a service nicety.</p></div>\n</div>\n<p>The Lead Response Management Study, presented in 2007 by Dr. James Oldroyd of MIT's Sloan School and InsideSales.com, analyzed more than 15,000 leads and over 100,000 call attempts across six companies. The odds of contacting a lead were 100 times lower at 30 minutes than at 5 minutes, and the odds of qualifying it were 21 times lower.</p>\n<p>Four years later, the same researchers published “The Short Life of Online Sales Leads” in Harvard Business Review. They sent web leads to 2,241 US companies. Only 37% responded within an hour, the average response time was 42 hours, and 23% never responded at all. Companies that reached out within an hour were nearly seven times as likely to qualify the lead as those that waited even an hour longer, and more than 60 times as likely as those that waited 24 hours or more.</p>\n<p class='dd-kicker'>Move 02 · Diagnose</p>\n<h2 id='measure'>Measure your real response time</h2>\n<div class='dd-move'>\n<div><span class='dd-lab'>What</span><p>Time from the moment a lead arrives to the first reply, and to the first human contact.</p></div>\n<div><span class='dd-lab'>Why it matters</span><p>Most teams believe they are faster than they are.</p></div>\n<div><span class='dd-lab'>Do this</span><p>Send yourself a test lead on every channel and time the replies.</p></div>\n</div>\n<p>The gap is not an old problem. In a 2026 test, Workato requested demos from 114 B2B companies. The average personalized email reply took 11 hours and 54 minutes, the average phone follow-up took 14 hours and 29 minutes, only 1 company sent a personal email within 5 minutes, and nearly 1 in 5 never replied by email at all.</p>\n<figure class='dd-fig'>\n<svg viewBox='0 0 640 290' role='img' aria-labelledby='sb1t sb1d' xmlns='http://www.w3.org/2000/svg'>\n<title id='sb1t'>Average response time to a demo request, 114 B2B companies, 2026</title>\n<desc id='sb1d'>Horizontal bar chart in hours. Phone follow-up: 14 hours 29 minutes. Companies without a lead routing tool: nearly 13 hours. Personalized email: 11 hours 54 minutes. Companies with a lead routing tool: 3 hours 32 minutes. A thin orange marker shows the 5-minute target near zero.</desc>\n<rect x='0' y='0' width='640' height='290' fill='#ffffff'/>\n<text x='24' y='28' class='svg-ax'>EXHIBIT · AVERAGE TIME TO RESPOND TO A DEMO REQUEST (HOURS)</text>\n<g stroke='#e3e8ee' stroke-width='1'>\n<line x1='200' y1='46' x2='200' y2='236'/><line x1='300' y1='46' x2='300' y2='236'/><line x1='400' y1='46' x2='400' y2='236'/><line x1='500' y1='46' x2='500' y2='236'/><line x1='600' y1='46' x2='600' y2='236'/>\n</g>\n<text x='24' y='74' class='svg-num'>Phone follow-up</text>\n<rect x='200' y='60' width='362' height='20' fill='#5b9e90'/><text x='568' y='75' class='svg-ax'>14H 29M</text>\n<text x='24' y='114' class='svg-num'>No routing tool</text>\n<rect x='200' y='100' width='325' height='20' fill='#5b9e90'/><text x='531' y='115' class='svg-ax'>~13H</text>\n<text x='24' y='154' class='svg-num'>Personal email</text>\n<rect x='200' y='140' width='298' height='20' fill='#5b9e90'/><text x='504' y='155' class='svg-ax'>11H 54M</text>\n<text x='24' y='194' class='svg-num'>With routing tool</text>\n<rect x='200' y='180' width='88' height='20' fill='#007a66'/><text x='294' y='195' class='svg-ax'>3H 32M</text>\n<text x='24' y='226' class='svg-num'>Target</text>\n<rect x='200' y='214' width='3' height='16' fill='#c2410c'/><text x='210' y='227' class='svg-ax'>5 MINUTES</text>\n<line x1='200' y1='236' x2='600' y2='236' stroke='#14181c' stroke-width='1.5'/>\n<text x='196' y='254' class='svg-ax'>0</text><text x='294' y='254' class='svg-ax'>4</text><text x='394' y='254' class='svg-ax'>8</text><text x='490' y='254' class='svg-ax'>12</text><text x='590' y='254' class='svg-ax'>16</text>\n<text x='24' y='280' class='svg-ax'>SOURCE: WORKATO TEST OF 114 B2B COMPANIES, MARCH 2026</text>\n</svg>\n<figcaption><b>Exhibit 1.</b> Even in 2026, the average B2B reply takes half a working day. A routing tool cut the average to about three and a half hours; the target is minutes. Source: Workato, 2026.</figcaption>\n</figure>\n<p>Run the same test on your own business this week. Send a lead through your website form, your Facebook Page, your ads and your phone line, and write down two times for each: the first reply, and the first time a person actually engages. Those two numbers are your baseline.</p>\n<p class='dd-kicker'>Move 03 · Automate</p>\n<h2 id='instant'>Make the first reply instant and useful</h2>\n<div class='dd-move'>\n<div><span class='dd-lab'>What</span><p>An automatic first reply on every channel, in seconds.</p></div>\n<div><span class='dd-lab'>Why it matters</span><p>It catches the lead while they are still looking, even when your team is busy.</p></div>\n<div><span class='dd-lab'>Do this</span><p>Answer the likely question and offer the next step in the same message.</p></div>\n</div>\n<p>An instant reply only helps if it moves the conversation forward. “Thanks, we will get back to you” is fast but empty. A useful first reply confirms what the lead asked for, answers the most common question, and offers one clear next step: a booking link, a price list, or two short qualifying questions. On Messenger and Instagram, an AI agent or chatbot does this well, using platforms such as <a href='https://www.dijaedadula.com/botcake' rel='sponsored nofollow'>Botcake</a> or <a href='https://manychat.partnerlinks.io/rozuomtj4677' rel='sponsored nofollow'>ManyChat</a> (affiliate links). The writing side is covered in <a href='https://www.dijaedadula.com/chatbot-conversation-design'>chatbot conversation design</a>, and the leaks that slow Messenger replies are in <a href='https://www.dijaedadula.com/facebook-messenger-missed-messages'>why businesses lose customers in Messenger</a>.</p>\n<p class='dd-kicker'>Move 04 · Route</p>\n<h2 id='route'>Route hot leads to a person, fast</h2>\n<div class='dd-move'>\n<div><span class='dd-lab'>What</span><p>A rule that alerts a named person the moment a lead shows buying intent.</p></div>\n<div><span class='dd-lab'>Why it matters</span><p>Automation opens the conversation; people close it.</p></div>\n<div><span class='dd-lab'>Do this</span><p>Define “hot”, name an owner and set a time limit for human contact.</p></div>\n</div>\n<p>Routing is where most of the time is lost. In the 2026 Workato test, companies using a lead routing tool responded in an average of 3 hours and 32 minutes, against nearly 13 hours for those without one. Routing does not need to be complicated: tag the lead as hot when it asks about price, availability or a booking, assign it to one person, and alert that person in the tool they already watch.</p>\n<figure class='dd-fig'>\n<svg viewBox='0 0 640 220' role='img' aria-labelledby='sb2t sb2d' xmlns='http://www.w3.org/2000/svg'>\n<title id='sb2t'>Response targets from the first message to follow-up</title>\n<desc id='sb2d'>A timeline with four target markers: instant automatic reply at zero minutes, hot lead routed to a named person within 5 minutes, human contact within 1 hour, and a follow-up within 24 hours if there is no reply. The 5-minute routing marker is highlighted in orange.</desc>\n<rect x='0' y='0' width='640' height='220' fill='#ffffff'/>\n<text x='24' y='28' class='svg-ax'>EXHIBIT · RESPONSE TARGETS (RECOMMENDED)</text>\n<g stroke='#e3e8ee' stroke-width='1'>\n<line x1='60' y1='50' x2='60' y2='170'/><line x1='230' y1='50' x2='230' y2='170'/><line x1='400' y1='50' x2='400' y2='170'/><line x1='570' y1='50' x2='570' y2='170'/>\n</g>\n<line x1='60' y1='130' x2='590' y2='130' stroke='#14181c' stroke-width='2'/>\n<circle cx='60' cy='130' r='8' fill='#007a66'/><text x='40' y='104' class='svg-num'>Instant reply</text>\n<circle cx='230' cy='130' r='9' fill='#c2410c'/><text x='196' y='80' class='svg-num'>Routed to owner</text><line x1='230' y1='86' x2='230' y2='120' stroke='#c2410c'/>\n<circle cx='400' cy='130' r='8' fill='#007a66'/><text x='364' y='104' class='svg-num'>Human contact</text>\n<circle cx='570' cy='130' r='8' fill='#007a66'/><text x='532' y='104' class='svg-num'>Follow-up</text>\n<text x='52' y='160' class='svg-ax'>0 MIN</text><text x='214' y='160' class='svg-ax'>5 MIN</text><text x='384' y='160' class='svg-ax'>1 HOUR</text><text x='548' y='160' class='svg-ax'>24 HOURS</text>\n<text x='24' y='204' class='svg-ax'>SPACING IS NOT TO SCALE</text>\n</svg>\n<figcaption><b>Exhibit 2.</b> Four targets to design for. The orange marker, a named owner within five minutes, is the one most businesses miss.</figcaption>\n</figure>\n<p>The handoff itself, including what the bot says while a person takes over, is in <a href='https://www.dijaedadula.com/ai-chatbot-human-handoff'>the handoff playbook</a>.</p>\n<div class='dd-bottom'><span class='dd-note-label'>Dijae's rule</span><p>The first reply is yours to lose. Make it instant, make it useful, and make sure one person owns what happens next.</p></div>\n<p class='dd-kicker'>Move 05 · Prove</p>\n<h2 id='prove'>Cover the off-hours, then prove it with numbers</h2>\n<div class='dd-move'>\n<div><span class='dd-lab'>What</span><p>A plan for nights, weekends and lunch breaks, and a weekly speed report.</p></div>\n<div><span class='dd-lab'>Why it matters</span><p>Leads do not arrive in office hours, and slow replies hide in averages.</p></div>\n<div><span class='dd-lab'>Do this</span><p>Track the median and the slowest 10% of replies, not just the average.</p></div>\n</div>\n<p>After hours, the automatic reply carries the conversation: it answers, books where it can and tells the lead exactly when a person will be back. For calls, an <a href='https://www.dijaedadula.com/ai-voice-receptionist-appointments'>AI voice receptionist</a> does the same job on the phone line. Then follow up on a schedule; the sequence is in <a href='https://www.dijaedadula.com/automate-lead-follow-up'>how to automate lead follow-up</a>.</p>\n<p><b>Success metric:</b> median time from lead arrival to the first human contact for qualified leads, tracked weekly by channel, with the slowest 10% of replies reviewed by name.</p>\n<div class='dd-table-wrap'><table class='dd-check'>\n<thead><tr><th></th><th>Speed-to-lead checklist</th></tr></thead>\n<tbody>\n<tr><td></td><td>Every channel sends a useful automatic reply within seconds</td></tr>\n<tr><td></td><td>“Hot lead” is defined in writing (price, availability, booking)</td></tr>\n<tr><td></td><td>Every hot lead has a named owner and an alert</td></tr>\n<tr><td></td><td>Human contact target: within 1 hour in business hours</td></tr>\n<tr><td></td><td>Off-hours reply states when a person will be back</td></tr>\n<tr><td></td><td>Test leads are sent monthly on every channel and timed</td></tr>\n</tbody>\n</table></div>\n<p>An honest limitation: the best-known studies are from 2007 and 2011, they measured US web leads, and they show strong patterns rather than proof that speed alone causes the sale. A fast reply cannot rescue a weak offer or the wrong lead. Treat the research as a direction, then test it against your own numbers.</p>\n<h2 id='faq'>Frequently asked questions</h2>\n<h3>What is a good lead response time?</h3>\n<p>Aim for an automatic, useful reply within seconds and human contact with qualified leads within five minutes to one hour. Research found that the odds of contacting and qualifying a lead fall sharply after the first five minutes.</p>\n<h3>What does speed to lead mean?</h3>\n<p>Speed to lead is the time between a lead reaching out (a form, a message, a call) and your business responding. It is usually measured as time to first reply and time to first human contact.</p>\n<h3>How fast do most businesses respond to leads?</h3>\n<p>Slowly. A 2011 study of 2,241 US companies found an average response time of 42 hours, and a 2026 test of 114 B2B companies found an average email reply time of almost 12 hours.</p>\n<h3>Can AI reply to leads instantly?</h3>\n<p>Yes. An AI chatbot or voice agent can reply in seconds on chat channels and the phone, answer common questions and book appointments. Keep a person responsible for qualified leads, and route them quickly.</p>\n<div class='dd-cta'>\n<p class='dd-cta-title'>Get every lead a reply in minutes</p>\n<p>Want instant replies, hot-lead routing and a weekly speed report set up for your channels? <a href='https://www.dijaedadula.com/book'>Book a free AI Automation Blueprint call</a>.</p>\n<p>Prefer to learn it step by step? <a href='https://grow.dijaedadula.com/newsletter'>Join the free weekly newsletter</a>.</p>\n</div>\n<h2>References</h2>\n<ol class='dd-refs'>\n<li><a href='https://www.mortech.com/hs-fs/hub/25649/file-13535879-pdf/docs/mit_study.pdf' target='_blank' rel='noopener'>The Lead Response Management Study</a>, Oldroyd (MIT Sloan) and Elkington (InsideSales.com), presented October 16, 2007.</li>\n<li><a href='https://hbr.org/2011/03/the-short-life-of-online-sales-leads' target='_blank' rel='noopener'>Oldroyd, McElheran and Elkington: The Short Life of Online Sales Leads</a>, Harvard Business Review, March 2011. Figures as summarized by <a href='https://www.smartcompany.com.au/marketing/20110704-are-you-letting-online-leads-go-cold/' target='_blank' rel='noopener'>SmartCompany</a>, July 2011.</li>\n<li><a href='https://www.workato.com/the-connector/lead-response-time-study/' target='_blank' rel='noopener'>Workato: B2B lead response times, what we learned from 114 companies</a>, March 19, 2026.</li>\n</ol>\n<h2>Keep reading</h2>\n<ul class='dd-more'>\n<li><a href='https://www.dijaedadula.com/automate-lead-follow-up'>How to Automate Lead Follow-Up With AI (Without Sounding Like a Robot)</a></li>\n<li><a href='https://www.dijaedadula.com/facebook-messenger-missed-messages'>Why Your Business Is Losing Customers in Facebook Messenger (and How to Fix It)</a></li>\n<li><a href='https://www.dijaedadula.com/qualify-leads-messenger-automatically'>How to Qualify Leads in Messenger Automatically (Without Annoying Your Customers)</a></li>\n<li><a href='https://www.dijaedadula.com/blog'>See all posts on the blog</a></li>\n</ul>\n</div>\n"},"responsive":{"desktop":{"styles":{"height":6560,"left":160,"top":450,"width":640}},"mobile":{"styles":{"height":9440,"left":20,"top":423,"width":380}}}},{"id":"h_css2121","type":"html-box","specials":{"html":"&lt;style&gt;.dd-article ul{list-style:disc outside !important}.dd-article ol{list-style:decimal outside !important}.dd-article li{display:list-item !important}.dd-article ul ul{list-style:circle outside !important}&lt;/style&gt;"},"responsive":{"desktop":{"styles":{"height":1,"left":160,"top":7057,"width":1}},"mobile":{"styles":{"height":1,"left":20,"top":9902,"width":1}}}}]},{"id":"sec_2141","type":"section","responsive":{"desktop":{"styles":{"background":"rgba(247,248,250,1)","height":402}},"mobile":{"styles":{"background":"rgba(247,248,250,1)","height":508}}},"children":[{"id":"t_2142","type":"text-block","specials":{"tag":"h2","text":"Get one practical idea like this every week"},"responsive":{"desktop":{"styles":{"color":"rgba(26,26,26,1)","fontSize":26,"fontWeight":"800","height":69,"left":160,"lineHeight":"1.25","textAlign":"left","top":56,"width":640}},"mobile":{"styles":{"color":"rgba(26,26,26,1)","fontSize":22,"fontWeight":"800","height":59,"left":20,"lineHeight":"1.25","textAlign":"left","top":40,"width":380}}}},{"id":"t_2143","type":"text-block","specials":{"text":"Join the free newsletter on AI agents, automation and turning your skills into income. Prefer video? Watch the walkthroughs on <a href=\"https://www.youtube.com/c/DijaeDadulaPRO\" style=\"color:rgba(0,122,102,1);text-decoration:underline\">YouTube</a>."},"responsive":{"desktop":{"styles":{"color":"rgba(85,85,85,1)","fontSize":17,"fontWeight":"400","height":59,"left":160,"lineHeight":"1.6","textAlign":"left","top":137,"width":640}},"mobile":{"styles":{"color":"rgba(85,85,85,1)","fontSize":16,"fontWeight":"400","height":107,"left":20,"lineHeight":"1.6","textAlign":"left","top":109,"width":380}}}},{"id":"b_2144","type":"button","specials":{"text":"Subscribe free"}