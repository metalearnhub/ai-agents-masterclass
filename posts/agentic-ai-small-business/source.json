{"cartConfigs":{"isActive":false},"dynamic_pages":[],"options":{"mobileOnly":false,"versionID":null},"page":[{"id":"sec_2101","type":"section","responsive":{"desktop":{"styles":{"background":"rgba(255,255,255,1)","height":72}},"mobile":{"styles":{"background":"rgba(255,255,255,1)","height":66}}},"children":[{"id":"t_2102","type":"text-block","specials":{"text":"<a href=\"https://www.dijaedadula.com/home\" style=\"color:rgba(26,26,26,1);text-decoration:none\">DIJAE DADULA</a>"},"responsive":{"desktop":{"styles":{"color":"rgba(26,26,26,1)","fontSize":16,"fontWeight":"800","height":24,"left":160,"letterSpacing":"3px","lineHeight":"1.4","top":26,"width":260}},"mobile":{"styles":{"color":"rgba(26,26,26,1)","fontSize":14,"fontWeight":"800","height":22,"left":20,"letterSpacing":"2px","lineHeight":"1.4","top":22}}}},{"id":"b_2103","type":"button","specials":{"text":"Subscribe"},"events":[{"action":"open_link","id":"ev_2104","target":"https://grow.dijaedadula.com/newsletter","targetURL":"_self","type":"click"}],"responsive":{"desktop":{"styles":{"background":"rgba(0,122,102,1)","borderRadius":"8px","color":"rgba(255,255,255,1)","fontSize":15,"fontWeight":"700","height":40,"left":650,"textAlign":"center","top":16}},"mobile":{"styles":{"background":"rgba(0,122,102,1)","borderRadius":"8px","color":"rgba(255,255,255,1)","fontSize":14,"fontWeight":"700","height":38,"left":270,"textAlign":"center","top":14,"width":130}}}},{"id":"n_2105","type":"text-block","specials":{"text":"<a href=\"https://grow.dijaedadula.com/newsletter\" style=\"color:rgba(26,26,26,1);text-decoration:none\">Newsletter</a>"},"responsive":{"desktop":{"styles":{"color":"rgba(26,26,26,1)","fontSize":15,"fontWeight":"500","height":24,"left":532,"lineHeight":"1.4","textAlign":"center","top":26,"width":110}},"mobile":{"config":{"hide":true},"styles":{"color":"rgba(26,26,26,1)","fontSize":14,"height":22,"left":270,"lineHeight":"1.4","textAlign":"center","top":22,"width":130}}}},{"id":"n_2106","type":"text-block","specials":{"text":"<a href=\"https://www.dijaedadula.com/blog\" style=\"color:rgba(26,26,26,1);text-decoration:none\">Blog</a>"},"responsive":{"desktop":{"styles":{"color":"rgba(26,26,26,1)","fontSize":15,"fontWeight":"500","height":24,"left":414,"lineHeight":"1.4","textAlign":"center","top":26,"width":110}},"mobile":{"config":{"hide":true},"styles":{"color":"rgba(26,26,26,1)","fontSize":14,"height":22,"left":270,"lineHeight":"1.4","textAlign":"center","top":22,"width":130}}}},{"id":"l_2107","type":"line","responsive":{"desktop":{"styles":{"borderColor":"rgba(230,232,236,1)","left":0,"top":63,"width":960}},"mobile":{"styles":{"borderColor":"rgba(230,232,236,1)","left":0,"top":60,"width":420}}}}]},{"id":"sec_2108","type":"section","responsive":{"desktop":{"styles":{"background":"rgba(255,255,255,1)","height":7404}},"mobile":{"styles":{"background":"rgba(255,255,255,1)","height":10348}}},"children":[{"id":"t_2109","type":"text-block","specials":{"text":"<a href=\"https://www.dijaedadula.com/blog\" style=\"color:rgba(0,122,102,1);text-decoration:underline\">Blog</a> · AI agents and workflows"},"responsive":{"desktop":{"styles":{"color":"rgba(120,120,120,1)","fontSize":14,"fontWeight":"400","height":25,"left":160,"lineHeight":"1.5","textAlign":"left","top":64,"width":640}},"mobile":{"styles":{"color":"rgba(120,120,120,1)","fontSize":13,"fontWeight":"400","height":24,"left":20,"lineHeight":"1.5","textAlign":"left","top":48,"width":380}}}},{"id":"t_2110","type":"text-block","specials":{"tag":"h1","text":"What Agentic AI Means for Small Businesses in 2026"},"responsive":{"desktop":{"styles":{"color":"rgba(26,26,26,1)","fontSize":42,"fontWeight":"800","height":105,"left":160,"lineHeight":"1.18","textAlign":"left","top":105,"width":640}},"mobile":{"styles":{"color":"rgba(26,26,26,1)","fontSize":30,"fontWeight":"800","height":112,"left":20,"lineHeight":"1.18","textAlign":"left","top":84,"width":380}}}},{"id":"t_2111","type":"text-block","specials":{"text":"What the 2026 McKinsey and Gartner data say about AI agents, why smaller firms are falling behind, how to spot agent washing, and a decision checklist before you buy."},"responsive":{"desktop":{"styles":{"color":"rgba(85,85,85,1)","fontSize":21,"fontWeight":"400","height":98,"left":160,"lineHeight":"1.5","textAlign":"left","top":228,"width":640}},"mobile":{"styles":{"color":"rgba(85,85,85,1)","fontSize":18,"fontWeight":"400","height":112,"left":20,"lineHeight":"1.5","textAlign":"left","top":210,"width":380}}}},{"id":"t_2112","type":"text-block","specials":{"text":"By <a href=\"https://www.dijaedadula.com/home\" style=\"color:rgba(0,122,102,1);text-decoration:underline\">Dijae Dadula</a> · November 26, 2026 · 8 min read"},"responsive":{"desktop":{"styles":{"color":"rgba(120,120,120,1)","fontSize":14,"fontWeight":"400","height":25,"left":160,"lineHeight":"1.5","textAlign":"left","top":344,"width":640}},"mobile":{"styles":{"color":"rgba(120,120,120,1)","fontSize":13,"fontWeight":"400","height":24,"left":20,"lineHeight":"1.5","textAlign":"left","top":336,"width":380}}}},{"id":"eb_2120","type":"editor-blog","specials":{"html":"<div class='dd-article dd-b'>\n<figure class='dd-fig'><div class='dd-shot' style='aspect-ratio:16/9'><img src='https://statics.pancake.vn/web-media-264/c7/fc/67/4a/1ffa6b3f42e69dfe65e0c388f473b89b50dbb9d749c0016559fb1575-w:1536-h:864-l:33984-t:image/jpeg.jpg' alt='Dark isometric illustration of a tall grey block stack and a small block topped with a green-outlined layer and an agent node, linked by a dashed green path, beside a checklist tile' width='1536' height='864' loading='lazy'></div></figure>\n<div class='dd-brief'>\n<p class='dd-brief-title'>The 60-second brief</p>\n<ol>\n<li>Agentic AI for small business is real, but adoption is uneven: in McKinsey's 2026 survey, large organizations scaling AI agents rose to 40 percent while smaller organizations stayed flat at 22 percent.</li>\n<li>Gartner predicts over 40 percent of agentic AI projects will be canceled by the end of 2027, mostly on cost, unclear value and weak risk controls, and warns that many products are “agent washing.”</li>\n<li>Small businesses that win start with one bounded job, clean data and a person in charge, then widen the scope once the numbers prove it.</li>\n</ol>\n<p class='dd-decision'>Decision: pick one job with a clear number, run it with a human in the loop for a month, then decide on more.</p>\n</div>\n<div class='dd-tiles'>\n<div class='dd-tile'><b>22%</b><span>of smaller organizations scaling AI agents (McKinsey, 2026)</span></div>\n<div class='dd-tile'><b>40%+</b><span>of agentic AI projects Gartner expects canceled by end of 2027</span></div>\n<div class='dd-tile'><b>37%</b><span>of respondents who attribute any EBIT impact to AI (McKinsey, 2026)</span></div>\n</div>\n<p>Agentic AI means AI systems that do more than answer: they decide the next step and take actions through your tools, such as booking, updating a record or sending a follow-up. For a small business in 2026, the question is no longer whether AI agents exist. It is which job is worth handing to one, and how to avoid paying for a project that gets canceled. This brief uses the latest public data to answer that.</p>\n<nav class='dd-toc' aria-label='Table of contents'>\n<p class='dd-toc-title'>In this brief</p>\n<ol>\n<li><a href='#data'>What does the 2026 data say about AI agents?</a></li>\n<li><a href='#washing'>Is it a real agent, or agent washing?</a></li>\n<li><a href='#start'>Agentic AI for small business: where should you start?</a></li>\n<li><a href='#measure'>How do you know it is working?</a></li>\n<li><a href='#faq'>FAQ</a></li>\n</ol>\n</nav>\n<p class='dd-kicker'>Move 01 · Read the data</p>\n<h2 id='data'>What does the 2026 data say about AI agents?</h2>\n<div class='dd-move'>\n<div><span class='dd-lab'>What</span><p>Big companies are pulling ahead on AI agents; smaller ones are holding still.</p></div>\n<div><span class='dd-lab'>Why it matters</span><p>The gap is about execution, not access. The same tools are available to everyone.</p></div>\n<div><span class='dd-lab'>Do this</span><p>Treat agents as an operations project with an owner, not a software purchase.</p></div>\n</div>\n<p>McKinsey's <i>The state of AI in 2026: On the road to ROI</i>, published August 25, 2026, surveyed 1,719 participants in 97 nations between May 4 and June 8, 2026. Its clearest finding on AI agents is a split by company size.</p>\n<figure class='dd-fig'>\n<svg class='dk' viewBox='0 0 640 280' role='img' aria-labelledby='bg1t bg1d' xmlns='http://www.w3.org/2000/svg'>\n<title id='bg1t'>Share of respondents scaling AI agents, 2025 vs 2026</title>\n<desc id='bg1d'>Horizontal bar chart on a 0 to 50 percent axis (percent of respondents). Large organizations: 27 percent in 2025, 40 percent in 2026, highlighted. Smaller organizations: 22 percent in 2025 and 22 percent in 2026.</desc>\n<defs><linearGradient id='bg1g' x1='0' y1='0' x2='0' y2='1'><stop offset='0' stop-color='#1f2224'/><stop offset='1' stop-color='#0a0b0c'/></linearGradient></defs>\n<rect x='0' y='0' width='640' height='280' rx='14' fill='url(#bg1g)'/>\n<text class='svg-ax' x='24' y='34'>EXHIBIT · SCALING AI AGENTS, BY COMPANY SIZE</text>\n<g stroke='#2a2e31' stroke-width='1'><line x1='180' y1='56' x2='180' y2='230'/><line x1='268' y1='56' x2='268' y2='230'/><line x1='356' y1='56' x2='356' y2='230'/><line x1='444' y1='56' x2='444' y2='230'/><line x1='532' y1='56' x2='532' y2='230'/><line x1='620' y1='56' x2='620' y2='230'/></g>\n<text class='svg-t' x='24' y='86'>Large orgs</text>\n<text class='svg-s' x='24' y='104'>2025 / 2026</text>\n<rect x='180' y='70' width='238' height='20' rx='3' fill='#3a3f43'/><text class='svg-num' x='426' y='85'>27%</text>\n<rect x='180' y='96' width='352' height='20' rx='3' fill='#3fbfa6'/><text class='svg-num' x='540' y='111'>40%</text>\n<text class='svg-t' x='24' y='166'>Smaller orgs</text>\n<text class='svg-s' x='24' y='184'>2025 / 2026</text>\n<rect x='180' y='150' width='194' height='20' rx='3' fill='#3a3f43'/><text class='svg-num' x='382' y='165'>22%</text>\n<rect x='180' y='176' width='194' height='20' rx='3' fill='#8a8f94'/><text class='svg-num' x='382' y='191'>22%</text>\n<text class='svg-ax' x='176' y='252'>0</text><text class='svg-ax' x='258' y='252'>10</text><text class='svg-ax' x='346' y='252'>20</text><text class='svg-ax' x='434' y='252'>30</text><text class='svg-ax' x='522' y='252'>40</text><text class='svg-ax' x='604' y='252'>50</text>\n</svg>\n<figcaption><b>Exhibit 1.</b> Large organizations moved from 27 to 40 percent scaling AI agents in a year; smaller organizations stayed at 22 percent. Source: McKinsey, 2026.</figcaption>\n</figure>\n<p>Two more numbers frame the decision. Only 37 percent of respondents attribute any EBIT impact to AI, “about the same share as last year,” and the high performers who attribute 5 percent or more of EBIT to AI stayed at about 6 percent of respondents. Where agents are scaled, McKinsey says respondents most often use them in IT, knowledge management and software engineering, with retail and consumer goods using them in marketing and sales.</p>\n<p>Read this carefully. McKinsey's comparison is between organizations with at least $1 billion in annual revenue and everyone smaller, so its “smaller” group includes many companies far larger than a typical clinic, shop or agency. The direction still matters: small business AI adoption of agents is not keeping pace, and the reason is rarely the technology.</p>\n<p class='dd-kicker'>Move 02 · Filter the market</p>\n<h2 id='washing'>Is it a real agent, or agent washing?</h2>\n<div class='dd-move'>\n<div><span class='dd-lab'>What</span><p>Many tools sold as agents are chatbots or assistants with a new label.</p></div>\n<div><span class='dd-lab'>Why it matters</span><p>You pay agent prices for features that cannot act on their own.</p></div>\n<div><span class='dd-lab'>Do this</span><p>Ask the vendor which actions the tool takes without a person, and in which systems.</p></div>\n</div>\n<p>In a June 25, 2025 press release, Gartner predicted that over 40 percent of agentic AI projects will be canceled by the end of 2027, citing “escalating costs, unclear business value, and inadequate risk controls.” It also named the problem of “agent washing”: rebranding existing assistants, robotic process automation or chatbots as agents without real agentic capability. By Gartner's estimate, of the thousands of vendors claiming agentic AI, only about 130 are real.</p>\n<p>The same research shows how undecided buyers were. In a January 2025 Gartner poll of 3,412 webinar attendees:</p>\n<figure class='dd-fig'>\n<svg class='dk' viewBox='0 0 640 250' role='img' aria-labelledby='bg2t bg2d' xmlns='http://www.w3.org/2000/svg'>\n<title id='bg2t'>How organizations were investing in agentic AI, January 2025</title>\n<desc id='bg2d'>Horizontal bar chart on a 0 to 50 percent axis (percent of respondents). Significant investments 19 percent. Conservative investments 42 percent, highlighted. No investment 8 percent. Wait and see or unsure 31 percent.</desc>\n<defs><linearGradient id='bg2g' x1='0' y1='0' x2='0' y2='1'><stop offset='0' stop-color='#1f2224'/><stop offset='1' stop-color='#0a0b0c'/></linearGradient></defs>\n<rect x='0' y='0' width='640' height='250' rx='14' fill='url(#bg2g)'/>\n<text class='svg-ax' x='24' y='34'>EXHIBIT · AGENTIC AI INVESTMENT, GARTNER POLL</text>\n<g stroke='#2a2e31' stroke-width='1'><line x1='200' y1='52' x2='200' y2='206'/><line x1='284' y1='52' x2='284' y2='206'/><line x1='368' y1='52' x2='368' y2='206'/><line x1='452' y1='52' x2='452' y2='206'/><line x1='536' y1='52' x2='536' y2='206'/><line x1='620' y1='52' x2='620' y2='206'/></g>\n<text class='svg-t' x='24' y='76'>Significant</text><rect x='200' y='62' width='160' height='20' rx='3' fill='#8a8f94'/><text class='svg-num' x='368' y='77'>19%</text>\n<text class='svg-t' x='24' y='112'>Conservative</text><rect x='200' y='98' width='353' height='20' rx='3' fill='#3fbfa6'/><text class='svg-num' x='561' y='113'>42%</text>\n<text class='svg-t' x='24' y='148'>No investment</text><rect x='200' y='134' width='67' height='20' rx='3' fill='#8a8f94'/><text class='svg-num' x='275' y='149'>8%</text>\n<text class='svg-t' x='24' y='184'>Wait / unsure</text><rect x='200' y='170' width='260' height='20' rx='3' fill='#8a8f94'/><text class='svg-num' x='468' y='185'>31%</text>\n<text class='svg-ax' x='196' y='228'>0</text><text class='svg-ax' x='274' y='228'>10</text><text class='svg-ax' x='358' y='228'>20</text><text class='svg-ax' x='442' y='228'>30</text><text class='svg-ax' x='526' y='228'>40</text><text class='svg-ax' x='604' y='228'>50</text>\n</svg>\n<figcaption><b>Exhibit 2.</b> Most organizations were spending cautiously or waiting. Source: Gartner poll of 3,412 webinar attendees, January 2025.</figcaption>\n</figure>\n<p>For an owner, the practical test of agentic AI vs chatbot is simple. A chatbot answers. An agent decides the next step and acts in another system, such as your calendar, CRM or order list. If a product cannot show you those actions and a log of what it did, it is not an agent. The guide on <a href='https://www.dijaedadula.com/ai-agent-vs-chatbot-vs-automation'>AI agent vs chatbot vs automation</a> has a five-question test.</p>\n<p class='dd-kicker'>Move 03 · Start bounded</p>\n<h2 id='start'>Agentic AI for small business: where should you start?</h2>\n<div class='dd-move'>\n<div><span class='dd-lab'>What</span><p>One job, one number, one owner, with a person approving risky actions.</p></div>\n<div><span class='dd-lab'>Why it matters</span><p>Bounded projects are the ones that reach a return before the budget runs out.</p></div>\n<div><span class='dd-lab'>Do this</span><p>Fix the data the agent needs before you switch it on.</p></div>\n</div>\n<p>Salesforce's <i>State of Agentic AI in the Enterprise</i>, summarized for small businesses in October 2026, surveyed about 2,000 agentic AI decision-makers in 20 countries, so treat it as a signal from larger organizations. Two findings travel well. Respondents named clean, accessible data and a tightly bounded use case as top success factors, each cited by 36 percent. And 63 percent had agent errors tied to stale, missing or wrong data.</p>\n<p>Small businesses already feel the demand side. In a PayPal survey of nearly 1,000 small business owners published June 18, 2025, 76 percent were using or exploring AI tools and 83 percent would welcome AI built into tools they already use, while half remained hesitant to fully commit. That combination points to the same starting rule for AI agents for small business:</p>\n<ul>\n<li><b>Start where your data is already clean.</b> FAQs, services and prices, opening hours, an up-to-date calendar.</li>\n<li><b>Pick a job with a number.</b> Reply time to new inquiries, bookings per week, no-show rate.</li>\n<li><b>Keep a person on anything irreversible.</b> Refunds, payments and promises outside policy stay human. The <a href='https://www.dijaedadula.com/assist-first-automate-second'>assist first, automate second</a> ladder shows how to widen scope safely.</li>\n<li><b>Write the brief before anyone builds.</b> The <a href='https://www.dijaedadula.com/ai-agent-brief'>AI agent brief</a> captures the job, scope and launch test on one page.</li>\n</ul>\n<div class='dd-bottom'><span class='dd-note-label'>Dijae's rule</span><p>Buy the outcome, not the label. If a tool cannot name the job, the number it moves and the person who reviews it, it is not ready for your business.</p></div>\n<p class='dd-kicker'>Move 04 · Prove it</p>\n<h2 id='measure'>How do you know AI agents are working in 2026?</h2>\n<div class='dd-move'>\n<div><span class='dd-lab'>What</span><p>A 30-day pilot with a baseline, a target and a weekly review.</p></div>\n<div><span class='dd-lab'>Why it matters</span><p>Gartner's top cancellation reasons are cost and unclear value; both are measurable.</p></div>\n<div><span class='dd-lab'>Do this</span><p>Record the number before launch, then compare every week.</p></div>\n</div>\n<p>Use this checklist before you approve a pilot, and again before you expand it:</p>\n<div class='dd-table-wrap'><table class='dd-check'>\n<thead><tr><th></th><th>Decision checklist</th></tr></thead>\n<tbody>\n<tr><td></td><td>The agent has one named job and one number it should move</td></tr>\n<tr><td></td><td>We recorded that number for the 30 days before launch</td></tr>\n<tr><td></td><td>The data it uses (prices, policies, calendar) has a named owner</td></tr>\n<tr><td></td><td>The vendor showed us the actions it takes and the log of each one</td></tr>\n<tr><td></td><td>Refunds, payments and exceptions go to a person</td></tr>\n<tr><td></td><td>Total monthly cost is known, including usage fees</td></tr>\n<tr><td></td><td>Someone reviews conversations every week</td></tr>\n</tbody>\n</table></div>\n<p><b>Success metric:</b> after 30 days, the target number improved against the baseline, and the cost per result is lower than doing the job by hand. If not, stop or narrow the scope; that is what the checklist is for. The <a href='https://www.dijaedadula.com/chatbot-roi-metrics'>chatbot ROI metrics</a> guide and the <a href='https://www.dijaedadula.com/ai-chatbot-cost'>AI chatbot cost</a> breakdown give you the formulas.</p>\n<p>An honest limitation: most of the data on AI agents comes from surveys of larger organizations, and survey answers describe what respondents report, not audited results. There is still little public data on how very small businesses fare with agents, so treat these numbers as direction, and let your own 30-day baseline decide.</p>\n<h2 id='faq'>Frequently asked questions</h2>\n<h3>What is agentic AI in simple terms?</h3>\n<p>It is AI that can decide the next step in a task and take action in your tools, such as booking an appointment or updating a customer record, instead of only replying with text.</p>\n<h3>Is agentic AI worth it for a small business in 2026?</h3>\n<p>It can be, for a bounded job with clean data and a clear number, such as answering inquiries and booking appointments. Broad “do everything” projects are the ones most likely to stall.</p>\n<h3>What is agent washing?</h3>\n<p>Gartner's term for rebranding existing chatbots, assistants or automation tools as AI agents without adding real ability to plan and act. Ask any vendor to show the actions and logs.</p>\n<h3>How much does an AI agent cost a small business?</h3>\n<p>It depends on the platform, channels and message volume. Count the subscription, usage fees, setup and the time someone spends reviewing it each week before you compare it with doing the job by hand.</p>\n<div class='dd-cta'>\n<p class='dd-cta-title'>Get one practical AI guide every week</p>\n<p>Want decision briefs like this in your inbox? <a href='https://grow.dijaedadula.com/newsletter'>Join the free weekly newsletter</a>.</p>\n<p>Ready to pick your first agent job? <a href='https://www.dijaedadula.com/book'>Book a free AI Automation Blueprint call</a> and we will choose the job, the number and the pilot plan.</p>\n</div>\n<h2>References</h2>\n<ol class='dd-refs'>\n<li><a href='https://www.mckinsey.com/capabilities/quantumblack/our-insights/the-state-of-ai' target='_blank' rel='noopener'>McKinsey: The state of AI in 2026: On the road to ROI</a>, August 25, 2026.</li>\n<li><a href='https://www.gartner.com/en/newsroom/press-releases/2025-06-25-gartner-predicts-over-40-percent-of-agentic-ai-projects-will-be-canceled-by-end-of-2027' target='_blank' rel='noopener'>Gartner: Gartner Predicts Over 40% of Agentic AI Projects Will Be Canceled by End of 2027</a>, June 25, 2025. Summary also in <a href='https://sdtimes.com/agentic-ai/gartner-more-than-40-of-agentic-ai-projects-will-be-canceled-in-next-few-years/' target='_blank' rel='noopener'>SD Times</a>, June 30, 2025.</li>\n<li><a href='https://www.salesforce.com/blog/small-business/takeaways-from-the-state-of-agentic-ai-report-for-smb/' target='_blank' rel='noopener'>Salesforce: Takeaways from the State of Agentic AI report for SMBs</a>, October 27, 2026.</li>\n<li><a href='https://newsroom.paypal-corp.com/2025-06-18-Small-Businesses-Ready-for-AI-That-Acts-Not-Just-Assists' target='_blank' rel='noopener'>PayPal: Small Businesses Ready for AI That Acts, Not Just Assists</a>, June 18, 2025.</li>\n</ol>\n<h2>Keep reading</h2>\n<ul class='dd-more'>\n<li><a href='https://www.dijaedadula.com/ai-agent-vs-chatbot-vs-automation'>AI Agent vs Chatbot vs Automation: Which One Does Your Business Need?</a></li>\n<li><a href='https://www.dijaedadula.com/assist-first-automate-second'>Assist First, Automate Second: A Safe Rollout Path for AI in Your Business</a></li>\n<li><a href='https://www.dijaedadula.com/ai-agent-brief'>The AI Agent Brief: What to Decide Before Anyone Builds Your Chatbot</a></li>\n<li><a href='https://www.dijaedadula.com/blog'>See all posts on the blog</a></li>\n</ul>\n</div>\n"},"responsive":{"desktop":{"styles":{"height":6946,"left":160,"top":401,"width":640}},"mobile":{"styles":{"height":9911,"left":20,"top":388,"width":380}}}},{"id":"h_css2121","type":"html-box","specials":{"html":"&lt;style&gt;.dd-article ul{list-style:disc outside !important}.dd-article ol{list-style:decimal outside !important}.dd-article li{display:list-item !important}.dd-article ul ul{list-style:circle outside !important}&lt;/style&gt;"},"responsive":{"desktop":{"styles":{"height":1,"left":160,"top":7394,"width":1}},"mobile":{"styles":{"height":1,"left":20,"top":10338,"width":1}}}}]},{"id":"sec_2141","type":"section","responsive":{"desktop":{"styles":{"background":"rgba(247,248,250,1)","height":402}},"mobile":{"styles":{"background":"rgba(247,248,250,1)","height":508}}},"children":[{"id":"t_2142","type":"text-block","specials":{"tag":"h2","text":"Get one practical idea like this every week"},"responsive":{"desktop":{"styles":{"color":"rgba(26,26,26,1)","fontSize":26,"fontWeight":"800","height":69,"left":1