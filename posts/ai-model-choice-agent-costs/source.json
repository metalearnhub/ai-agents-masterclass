{"cartConfigs":{"isActive":false},"dynamic_pages":[],"options":{"mobileOnly":false,"versionID":null},"page":[{"id":"sec_2101","type":"section","responsive":{"desktop":{"styles":{"background":"rgba(255,255,255,1)","height":72}},"mobile":{"styles":{"background":"rgba(255,255,255,1)","height":66}}},"children":[{"id":"t_2102","type":"text-block","specials":{"text":"<a href=\"https://www.dijaedadula.com/home\" style=\"color:rgba(26,26,26,1);text-decoration:none\">DIJAE DADULA</a>"},"responsive":{"desktop":{"styles":{"color":"rgba(26,26,26,1)","fontSize":16,"fontWeight":"800","height":24,"left":160,"letterSpacing":"3px","lineHeight":"1.4","top":26,"width":260}},"mobile":{"styles":{"color":"rgba(26,26,26,1)","fontSize":14,"fontWeight":"800","height":22,"left":20,"letterSpacing":"2px","lineHeight":"1.4","top":22}}}},{"id":"b_2103","type":"button","specials":{"text":"Subscribe"},"events":[{"action":"open_link","id":"ev_2104","target":"https://grow.dijaedadula.com/newsletter","targetURL":"_self","type":"click"}],"responsive":{"desktop":{"styles":{"background":"rgba(0,122,102,1)","borderRadius":"8px","color":"rgba(255,255,255,1)","fontSize":15,"fontWeight":"700","height":40,"left":650,"textAlign":"center","top":16}},"mobile":{"styles":{"background":"rgba(0,122,102,1)","borderRadius":"8px","color":"rgba(255,255,255,1)","fontSize":14,"fontWeight":"700","height":38,"left":270,"textAlign":"center","top":14,"width":130}}}},{"id":"n_2105","type":"text-block","specials":{"text":"<a href=\"https://grow.dijaedadula.com/newsletter\" style=\"color:rgba(26,26,26,1);text-decoration:none\">Newsletter</a>"},"responsive":{"desktop":{"styles":{"color":"rgba(26,26,26,1)","fontSize":15,"fontWeight":"500","height":24,"left":532,"lineHeight":"1.4","textAlign":"center","top":26,"width":110}},"mobile":{"config":{"hide":true},"styles":{"color":"rgba(26,26,26,1)","fontSize":14,"height":22,"left":270,"lineHeight":"1.4","textAlign":"center","top":22,"width":130}}}},{"id":"n_2106","type":"text-block","specials":{"text":"<a href=\"https://www.dijaedadula.com/blog\" style=\"color:rgba(26,26,26,1);text-decoration:none\">Blog</a>"},"responsive":{"desktop":{"styles":{"color":"rgba(26,26,26,1)","fontSize":15,"fontWeight":"500","height":24,"left":414,"lineHeight":"1.4","textAlign":"center","top":26,"width":110}},"mobile":{"config":{"hide":true},"styles":{"color":"rgba(26,26,26,1)","fontSize":14,"height":22,"left":270,"lineHeight":"1.4","textAlign":"center","top":22,"width":130}}}},{"id":"l_2107","type":"line","responsive":{"desktop":{"styles":{"borderColor":"rgba(230,232,236,1)","left":0,"top":63,"width":960}},"mobile":{"styles":{"borderColor":"rgba(230,232,236,1)","left":0,"top":60,"width":420}}}}]},{"id":"sec_2108","type":"section","responsive":{"desktop":{"styles":{"background":"rgba(255,255,255,1)","height":7802}},"mobile":{"styles":{"background":"rgba(255,255,255,1)","height":10717}}},"children":[{"id":"t_2109","type":"text-block","specials":{"text":"<a href=\"https://www.dijaedadula.com/blog\" style=\"color:rgba(0,122,102,1);text-decoration:underline\">Blog</a> · AI agents and workflows"},"responsive":{"desktop":{"styles":{"color":"rgba(120,120,120,1)","fontSize":14,"fontWeight":"400","height":25,"left":160,"lineHeight":"1.5","textAlign":"left","top":64,"width":640}},"mobile":{"styles":{"color":"rgba(120,120,120,1)","fontSize":13,"fontWeight":"400","height":24,"left":20,"lineHeight":"1.5","textAlign":"left","top":48,"width":380}}}},{"id":"t_2110","type":"text-block","specials":{"tag":"h1","text":"Choosing the Right AI Model for a Business Agent (and Keeping Costs Down)"},"responsive":{"desktop":{"styles":{"color":"rgba(26,26,26,1)","fontSize":42,"fontWeight":"800","height":154,"left":160,"lineHeight":"1.18","textAlign":"left","top":105,"width":640}},"mobile":{"styles":{"color":"rgba(26,26,26,1)","fontSize":30,"fontWeight":"800","height":147,"left":20,"lineHeight":"1.18","textAlign":"left","top":84,"width":380}}}},{"id":"t_2111","type":"text-block","specials":{"text":"An executive brief on model tiers, routing, caching and batching, with verified price examples and a checklist before you switch models."},"responsive":{"desktop":{"styles":{"color":"rgba(85,85,85,1)","fontSize":21,"fontWeight":"400","height":98,"left":160,"lineHeight":"1.5","textAlign":"left","top":277,"width":640}},"mobile":{"styles":{"color":"rgba(85,85,85,1)","fontSize":18,"fontWeight":"400","height":112,"left":20,"lineHeight":"1.5","textAlign":"left","top":245,"width":380}}}},{"id":"t_2112","type":"text-block","specials":{"text":"By <a href=\"https://www.dijaedadula.com/home\" style=\"color:rgba(0,122,102,1);text-decoration:underline\">Dijae Dadula</a> · November 2, 2026 · 8 min read"},"responsive":{"desktop":{"styles":{"color":"rgba(120,120,120,1)","fontSize":14,"fontWeight":"400","height":25,"left":160,"lineHeight":"1.5","textAlign":"left","top":393,"width":640}},"mobile":{"styles":{"color":"rgba(120,120,120,1)","fontSize":13,"fontWeight":"400","height":24,"left":20,"lineHeight":"1.5","textAlign":"left","top":371,"width":380}}}},{"id":"eb_2120","type":"editor-blog","specials":{"html":"<div class='dd-article dd-b'>\n<figure class='dd-fig'><div class='dd-shot' style='aspect-ratio:16/9'><img src='https://statics.pancake.vn/web-media-264/e1/58/4c/0b/610c9c1ad220d419c597d14bf9d6f1e6eb38b47e9e40069b3615b335.png' alt='Isometric illustration of a routing hub sending paths to small, medium and large server blocks, with a falling cost bar chart, a coin stack and a control lever' width='1536' height='864' loading='lazy'></div></figure>\n<div class='dd-brief'>\n<p class='dd-brief-title'>The 60-second brief</p>\n<ol>\n<li>Within one provider, the top model can cost several times more per token than the small one. Most business chats do not need the top model.</li>\n<li>Route by job: small, fast models for routine replies; a larger model only for the hard cases.</li>\n<li>Caching repeated instructions and batching non-urgent work cut the bill further, without changing a word the customer sees.</li>\n</ol>\n<p class='dd-decision'>Decision: default to the smallest model that passes your test set, and pay for more intelligence only where the answer needs it.</p>\n</div>\n<div class='dd-tiles'>\n<div class='dd-tile'><b>6.7×</b><span>input price gap between Gemini 4 Argon and Gemini 3.5 Flash-Lite (rates to November 30, 2026)</span></div>\n<div class='dd-tile'><b>50%</b><span>lower price for Batch API jobs on the Gemini API</span></div>\n<div class='dd-tile'><b>90%</b><span>lower price for cached input on Gemini 3.5 Flash-Lite</span></div>\n</div>\n<p>This brief is for business owners and teams running an AI chatbot or agent who want to choose a model on purpose instead of by default. The figures come from Google's public Gemini API price list, used here as one verified example. The same levers exist at other providers.</p>\n<nav class='dd-toc' aria-label='Table of contents'>\n<p class='dd-toc-title'>In this brief</p>\n<ol>\n<li><a href='#jobs'>Move 01: Sort the jobs</a></li>\n<li><a href='#tiers'>Move 02: Match each job to a tier</a></li>\n<li><a href='#route'>Move 03: Route, then escalate</a></li>\n<li><a href='#cut'>Move 04: Cut the bill without cutting quality</a></li>\n<li><a href='#prove'>Move 05: Prove it with numbers</a></li>\n<li><a href='#faq'>FAQ</a></li>\n</ol>\n</nav>\n<p class='dd-kicker'>Move 01 · Diagnose</p>\n<h2 id='jobs'>Sort the jobs before you pick a model</h2>\n<div class='dd-move'>\n<div><span class='dd-lab'>What</span><p>List what the agent actually does: answering FAQs, qualifying leads, summarizing chats, drafting replies, reasoning over several tools.</p></div>\n<div><span class='dd-lab'>Why it matters</span><p>One model for everything means paying top-tier prices for “what are your opening hours?”</p></div>\n<div><span class='dd-lab'>Do this</span><p>Tag each job by difficulty and by volume. The model choice follows from those two tags.</p></div>\n</div>\n<p>In most business chatbots, the bulk of messages are routine: prices, hours, availability, booking, order status. A smaller share needs real reasoning, such as comparing options, handling a complaint or planning several tool steps. The goal is to price each group separately.</p>\n<p class='dd-kicker'>Move 02 · Match</p>\n<h2 id='tiers'>Match each job to a model tier</h2>\n<div class='dd-move'>\n<div><span class='dd-lab'>What</span><p>Providers sell model families in tiers: a small, fast model, a mid-size model and a top reasoning model.</p></div>\n<div><span class='dd-lab'>Why it matters</span><p>Price rises steeply between tiers, especially for output tokens.</p></div>\n<div><span class='dd-lab'>Do this</span><p>Start every job on the smallest tier and move up only when the test set says so.</p></div>\n</div>\n<figure class='dd-fig'>\n<svg viewBox='0 0 640 300' role='img' aria-labelledby='sb1t sb1d' xmlns='http://www.w3.org/2000/svg'>\n<title id='sb1t'>Gemini API standard prices per million tokens by tier</title>\n<desc id='sb1d'>Horizontal bar chart in US dollars per one million tokens, paid tier, standard, text, prompts up to 200 thousand tokens. Gemini 3.5 Flash-Lite: input 0.30, output 2.50. Gemini 3.8 Flash: input 0.75, output 3.75. Gemini 4 Argon: input 2.00, output 10.00.</desc>\n<rect x='0' y='0' width='640' height='300' fill='#ffffff'/>\n<text x='24' y='28' class='svg-ax'>EXHIBIT · GEMINI API PRICE PER 1M TOKENS (USD)</text>\n<g stroke='#e3e8ee' stroke-width='1'>\n<line x1='200' y1='48' x2='200' y2='250'/><line x1='300' y1='48' x2='300' y2='250'/><line x1='400' y1='48' x2='400' y2='250'/><line x1='500' y1='48' x2='500' y2='250'/><line x1='600' y1='48' x2='600' y2='250'/>\n</g>\n<text x='24' y='76' class='svg-num'>3.5 Flash-Lite</text>\n<rect x='200' y='58' width='10' height='16' fill='#007a66'/><text x='216' y='71' class='svg-ax'>0.30 IN</text>\n<rect x='200' y='78' width='83' height='16' fill='#5b9e90'/><text x='289' y='91' class='svg-ax'>2.50 OUT</text>\n<text x='24' y='138' class='svg-num'>3.8 Flash</text>\n<rect x='200' y='120' width='25' height='16' fill='#007a66'/><text x='231' y='133' class='svg-ax'>0.75 IN</text>\n<rect x='200' y='140' width='125' height='16' fill='#5b9e90'/><text x='331' y='153' class='svg-ax'>3.75 OUT</text>\n<text x='24' y='200' class='svg-num'>4 Argon</text>\n<rect x='200' y='182' width='67' height='16' fill='#007a66'/><text x='273' y='195' class='svg-ax'>2.00 IN</text>\n<rect x='200' y='202' width='333' height='16' fill='#c2410c'/><text x='539' y='215' class='svg-ax'>10.00 OUT</text>\n<line x1='200' y1='250' x2='600' y2='250' stroke='#14181c' stroke-width='1.5'/>\n<text x='196' y='270' class='svg-ax'>0</text><text x='296' y='270' class='svg-ax'>3</text><text x='396' y='270' class='svg-ax'>6</text><text x='496' y='270' class='svg-ax'>9</text><text x='590' y='270' class='svg-ax'>12</text>\n<text x='24' y='292' class='svg-ax'>PAID TIER, STANDARD, TEXT, PROMPTS UP TO 200K TOKENS</text>\n</svg>\n<figcaption><b>Exhibit 1.</b> Output tokens drive the gap: the top model's output price is four times the small model's. Source: Gemini API pricing, accessed November 2, 2026.</figcaption>\n</figure>\n<p>Two details matter for budgeting. First, output usually costs much more than input, so long answers are expensive answers. Second, models and prices move fast. Gemini 4 Argon, the newest model on the list, is priced at $2.00 input and $10.00 output per million tokens through November 30, 2026, doubling to $4.00 and $20.00 from December 1, 2026. Gemini 3.8 Flash doubles from January 1, 2027. Chat platforms follow the same tier pattern. Botcake's AI settings, for example, list GPT-5, GPT-5 mini and GPT-5 nano next to older GPT-4.1 and GPT-4o options, plus DeepSeek V4 Flash and V4 Pro. Start on a mini, nano or Flash model and move up only when your test set says so, and recheck the list from time to time, because older generations get retired. For reference, check the pricing page <a href='https://ai.google.dev/pricing' target='_blank' rel='noopener'>here</a>. OpenAI and Anthropic publish the same kind of tiered price lists; check their current rates <a href='https://openai.com/api/pricing/' target='_blank' rel='noopener'>here</a> and <a href='https://docs.claude.com/en/docs/about-claude/pricing' target='_blank' rel='noopener'>here</a>.</p>\n<p class='dd-kicker'>Move 03 · Route</p>\n<h2 id='route'>Route to the small model first, then escalate</h2>\n<div class='dd-move'>\n<div><span class='dd-lab'>What</span><p>A routing rule sends each message to the cheapest model that can handle it.</p></div>\n<div><span class='dd-lab'>Why it matters</span><p>High-volume, simple messages make up most of the bill, so they set the cost.</p></div>\n<div><span class='dd-lab'>Do this</span><p>Escalate to a larger model only for named cases: complaints, multi-step tool work, low-confidence answers.</p></div>\n</div>\n<figure class='dd-fig'>\n<svg viewBox='0 0 640 330' role='img' aria-labelledby='sb2t sb2d' xmlns='http://www.w3.org/2000/svg'>\n<title id='sb2t'>Model choice by task difficulty and volume</title>\n<desc id='sb2d'>A two by two matrix. Horizontal axis: task difficulty, low to high. Vertical axis: message volume, low to high. High volume and low difficulty: small model with caching. High volume and high difficulty: small model first, escalate hard cases. Low volume and low difficulty: small model, batch when not urgent. Low volume and high difficulty: top reasoning model.</desc>\n<rect x='0' y='0' width='640' height='330' fill='#ffffff'/>\n<text x='24' y='28' class='svg-ax'>EXHIBIT · WHICH MODEL FOR WHICH JOB</text>\n<rect x='110' y='48' width='250' height='110' fill='#e8f4f1' stroke='#d8dee4'/>\n<rect x='360' y='48' width='250' height='110' fill='#f6f8fa' stroke='#d8dee4'/>\n<rect x='110' y='158' width='250' height='110' fill='#f6f8fa' stroke='#d8dee4'/>\n<rect x='360' y='158' width='250' height='110' fill='#fff4ec' stroke='#d8dee4'/>\n<text x='126' y='84' class='svg-num'>Small model + caching</text><text x='126' y='106' class='svg-s'>FAQs, hours, prices, order status</text>\n<text x='376' y='84' class='svg-num'>Small first, escalate</text><text x='376' y='106' class='svg-s'>Lead qualification, mixed questions</text>\n<text x='126' y='194' class='svg-num'>Small model, batch</text><text x='126' y='216' class='svg-s'>Chat summaries, tagging, reports</text>\n<text x='376' y='194' class='svg-num'>Top reasoning model</text><text x='376' y='216' class='svg-s'>Complaints, multi-tool planning</text>\n<line x1='110' y1='268' x2='616' y2='268' stroke='#14181c' stroke-width='1.5'/>\n<line x1='110' y1='268' x2='110' y2='42' stroke='#14181c' stroke-width='1.5'/>\n<text x='110' y='290' class='svg-ax'>LOW</text><text x='300' y='290' class='svg-ax'>TASK DIFFICULTY</text><text x='580' y='290' class='svg-ax'>HIGH</text>\n<text x='24' y='64' class='svg-ax'>HIGH</text><text x='24' y='166' class='svg-ax'>VOLUME</text><text x='24' y='266' class='svg-ax'>LOW</text>\n</svg>\n<figcaption><b>Exhibit 2.</b> Volume decides what dominates the bill; difficulty decides where a larger model earns its price.</figcaption>\n</figure>\n<p>Simple escalation rules work well: hand the message to the larger model when the small one says it is unsure, when the customer is upset, or when the job needs more than one tool. Everything else stays on the small model. The same triggers often decide when a person should step in, as covered in <a href='https://www.dijaedadula.com/ai-chatbot-human-handoff'>the handoff playbook</a>.</p>\n<p class='dd-kicker'>Move 04 · Optimize</p>\n<h2 id='cut'>Cut the bill without cutting quality</h2>\n<div class='dd-move'>\n<div><span class='dd-lab'>What</span><p>Four levers: caching, batching, shorter prompts and capped answers.</p></div>\n<div><span class='dd-lab'>Why it matters</span><p>None of them change what the customer reads.</p></div>\n<div><span class='dd-lab'>Do this</span><p>Turn on caching for your fixed instructions and knowledge, and batch anything that can wait.</p></div>\n</div>\n<div class='dd-table-wrap'><table>\n<thead><tr><th>Lever</th><th>How it saves</th><th>Example rate (Gemini 3.5 Flash-Lite)</th></tr></thead>\n<tbody>\n<tr><td>Context caching</td><td>Instructions and knowledge sent with every message are billed at a lower cached rate</td><td>$0.03 per 1M cached input tokens vs $0.30 standard, plus $1.00 per 1M tokens per hour of storage</td></tr>\n<tr><td>Batch API</td><td>Non-urgent jobs (summaries, tagging, reports) run asynchronously at a discount</td><td>$0.15 input / $1.25 output vs $0.30 / $2.50 standard</td></tr>\n<tr><td>Shorter prompts</td><td>Fewer input tokens on every single call</td><td>Remove duplicate rules and old knowledge files</td></tr>\n<tr><td>Capped answers</td><td>Fewer output tokens, the most expensive part</td><td>Set a reply length in the instructions and a max output limit</td></tr>\n</tbody>\n</table></div>\n<p><b>Illustrative example</b> (the token counts and volume are invented; the prices are the Gemini list prices above): an agent handles 10,000 replies a month, each with 3,000 input tokens of instructions, knowledge and conversation, and a 300-token answer.</p>\n<div class='dd-table-wrap'><table>\n<thead><tr><th>Setup</th><th>Cost per reply</th><th>Per month</th></tr></thead>\n<tbody>\n<tr><td>Gemini 4 Argon for everything (price to November 30, 2026)</td><td>$0.0090</td><td>$90.00</td></tr>\n<tr><td>Gemini 4 Argon for everything (price from December 1, 2026)</td><td>$0.0180</td><td>$180.00</td></tr>\n<tr><td>Gemini 3.8 Flash for everything</td><td>$0.0034</td><td>$33.75</td></tr>\n<tr><td>Gemini 3.5 Flash-Lite for everything</td><td>$0.0017</td><td>$16.50</td></tr>\n<tr><td>3.5 Flash-Lite, 2,500 of the input tokens cached</td><td>$0.0010</td><td>$11.55 incl. storage</td></tr>\n</tbody>\n</table></div>\n<p>The absolute amounts are small at this volume. The ratio is the point: the same traffic costs about eight times more on the top model than on the cached small model (about sixteen times once the December price applies), and the gap grows with every new channel and campaign. For the full cost picture beyond tokens, see <a href='https://www.dijaedadula.com/ai-chatbot-cost'>how much an AI chatbot really costs</a>.</p>\n<div class='dd-bottom'><span class='dd-note-label'>Dijae's rule</span><p>Pay for intelligence only where the answer needs it. Every other message goes to the smallest model that passes the test.</p></div>\n<p class='dd-kicker'>Move 05 · Prove</p>\n<h2 id='prove'>Prove the choice with numbers</h2>\n<div class='dd-move'>\n<div><span class='dd-lab'>What</span><p>Run the same test set on each candidate model before you switch.</p></div>\n<div><span class='dd-lab'>Why it matters</span><p>A cheaper model that answers wrongly costs more in lost sales and corrections.</p></div>\n<div><span class='dd-lab'>Do this</span><p>Compare pass rate and cost per resolved conversation, not price per token.</p></div>\n</div>\n<p><b>Success metric:</b> cost per resolved conversation, meaning total model cost divided by conversations that ended with an answer or a booked next step, with the pass rate on your test set held at or above today's level. The test method is in <a href='https://www.dijaedadula.com/how-to-test-an-ai-chatbot'>how to test an AI chatbot</a>, and the weekly review that catches drift after a switch is in <a href='https://www.dijaedadula.com/ai-agent-monitoring-weekly-review'>AI agent monitoring after launch</a>.</p>\n<div class='dd-table-wrap'><table class='dd-check'>\n<thead><tr><th></th><th>Decision checklist before you switch models</th></tr></thead>\n<tbody>\n<tr><td></td><td>Jobs are tagged by difficulty and volume</td></tr>\n<tr><td></td><td>The small model passes the test set for routine jobs</td></tr>\n<tr><td></td><td>Escalation rules are written and tested</td></tr>\n<tr><td></td><td>Caching is on for fixed instructions and knowledge</td></tr>\n<tr><td></td><td>Non-urgent jobs run as batch</td></tr>\n<tr><td></td><td>Cost per resolved conversation is tracked weekly</td></tr>\n</tbody>\n</table></div>\n<p>An honest limitation: model names, prices and quality change every few months, and a public benchmark says little about your customers' questions. Treat any model choice as a decision you re-test each quarter, and re-check the price list before you budget.</p>\n<h2 id='faq'>Frequently asked questions</h2>\n<h3>What is the best AI model for a business chatbot?</h3>\n<p>For most routine customer questions, a small, fast model from a major provider is enough. Use a larger reasoning model only for complex cases, and choose based on your own test set rather than public rankings.</p>\n<h3>How can I reduce AI agent costs?</h3>\n<p>Route routine messages to a small model, cache the instructions and knowledge sent with every message, batch non-urgent jobs, shorten prompts and cap answer length. Then track cost per resolved conversation.</p>\n<h3>Why do output tokens cost more than input tokens?</h3>\n<p>Providers price generated text higher than text you send. On the Gemini API price list, output tokens cost several times more than input tokens on every tier, so long answers raise the bill quickly.</p>\n<h3>How often should I review my AI model choice?</h3>\n<p>Review it at least every quarter and whenever a provider changes prices or releases a new model. Re-run your test set before switching.</p>\n<div class='dd-cta'>\n<p class='dd-cta-title'>Get a model and cost plan for your agent</p>\n<p>Want your jobs mapped to model tiers, with routing, caching and a cost dashboard set up? <a href='https://www.dijaedadula.com/book'>Book a free AI Automation Blueprint call</a>.</p>\n<p>Prefer to learn it step by step? <a href='https://grow.dijaedadula.com/newsletter'>Join the free weekly newsletter</a>.</p>\n</div>\n<h2>References</h2>\n<ol class='dd-refs'>\n<li><a href='https://ai.google.dev/pricing' target='_blank' rel='noopener'>Google AI for Developers: Gemini API pricing</a> (paid tier per 1M tokens, context caching, Batch API). Accessed November 2026.</li>\n<li><a href='https://openai.com/api/pricing/' target='_blank' rel='noopener'>OpenAI API pricing</a>. Check current rates before budgeting.</li>\n<li><a href='https://docs.claude.com/en/docs/about-claude/pricing' target='_blank' rel='noopener'>Anthropic Claude API pricing</a>. Check current rates before budgeting.</li>\n</ol>\n<h2>Keep reading</h2>\n<ul class='dd-more'>\n<li><a href='https://www.dijaedadula.com/ai-chatbot-cost'>How Much Does an AI Chatbot Really Cost a Small Business? (2026 Math)</a></li>\n<li><a href='https://www.dijaedadula.com/ai-agent-vs-chatbot-vs-automation'>AI Agent vs Chatbot vs Automation: Which One Does Your Business Need?</a></li>\n<li><a href='https://www.dijaedadula.com/chatbot-roi-metrics'>How Much Does an AI Agent Save? The 5 Chatbot ROI Metrics That Matter</a></li>\n<li><a href='https://www.dijaedadula.com/blog'>See all posts on the blog</a></li>\n</ul>\n</div>\n"},"responsive":{"desktop":{"styles":{"height":7295,"left":160,"top":450,"width":640}},"mobile":{"styles":{"height":10245,"left":20,"top":423,"width":380}}}},{"id":"h_css2121","type":"html-box","specials":{"html":"&lt;style&gt;.dd-article ul{list-style:disc outside !important}.dd-article ol{list-style:decimal outside !important}.dd-article li{display:list-item !important}.dd-article ul ul{list-style:circle outside !important}&lt;/style&gt;"},"responsive":{"desktop":{"styles":{"height":1,"left":160,"top":7792,"width":1}},"mobile":{"styles":{"height":1,"left":20,"top":10707,"width":1}}}}]},{"id":"sec_2141","type":"section","responsive":{"desktop":{"styles":{"background":"rgba(247,248,250,1)","height":402}},"mobile":{"styles":{"background":"rgba(247,248,250,1)","height":508}}},"children":[{"id":"t_2142","type":"text-block","specials":{"tag":"h2","text":"Get one practical idea like this every week"},"responsive":{"desktop":{"styles":{"color":"rgba(26,26,26,1)","fontSize":26,"fontWeight":"800","height":69,"left":160,"lineHeight":"1.25","textAl