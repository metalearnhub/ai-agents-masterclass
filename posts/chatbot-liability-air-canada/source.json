{"cartConfigs":{"isActive":false},"dynamic_pages":[],"options":{"mobileOnly":false,"versionID":null},"page":[{"id":"sec_2101","type":"section","responsive":{"desktop":{"styles":{"background":"rgba(255,255,255,1)","height":72}},"mobile":{"styles":{"background":"rgba(255,255,255,1)","height":66}}},"children":[{"id":"t_2102","type":"text-block","specials":{"text":"<a href=\"https://www.dijaedadula.com/home\" style=\"color:rgba(26,26,26,1);text-decoration:none\">DIJAE DADULA</a>"},"responsive":{"desktop":{"styles":{"color":"rgba(26,26,26,1)","fontSize":16,"fontWeight":"800","height":24,"left":160,"letterSpacing":"3px","lineHeight":"1.4","top":26,"width":260}},"mobile":{"styles":{"color":"rgba(26,26,26,1)","fontSize":14,"fontWeight":"800","height":22,"left":20,"letterSpacing":"2px","lineHeight":"1.4","top":22}}}},{"id":"b_2103","type":"button","specials":{"text":"Subscribe"},"events":[{"action":"open_link","id":"ev_2104","target":"https://grow.dijaedadula.com/newsletter","targetURL":"_self","type":"click"}],"responsive":{"desktop":{"styles":{"background":"rgba(0,122,102,1)","borderRadius":"8px","color":"rgba(255,255,255,1)","fontSize":15,"fontWeight":"700","height":40,"left":650,"textAlign":"center","top":16}},"mobile":{"styles":{"background":"rgba(0,122,102,1)","borderRadius":"8px","color":"rgba(255,255,255,1)","fontSize":14,"fontWeight":"700","height":38,"left":270,"textAlign":"center","top":14,"width":130}}}},{"id":"n_2105","type":"text-block","specials":{"text":"<a href=\"https://grow.dijaedadula.com/newsletter\" style=\"color:rgba(26,26,26,1);text-decoration:none\">Newsletter</a>"},"responsive":{"desktop":{"styles":{"color":"rgba(26,26,26,1)","fontSize":15,"fontWeight":"500","height":24,"left":532,"lineHeight":"1.4","textAlign":"center","top":26,"width":110}},"mobile":{"config":{"hide":true},"styles":{"color":"rgba(26,26,26,1)","fontSize":14,"height":22,"left":270,"lineHeight":"1.4","textAlign":"center","top":22,"width":130}}}},{"id":"n_2106","type":"text-block","specials":{"text":"<a href=\"https://www.dijaedadula.com/blog\" style=\"color:rgba(26,26,26,1);text-decoration:none\">Blog</a>"},"responsive":{"desktop":{"styles":{"color":"rgba(26,26,26,1)","fontSize":15,"fontWeight":"500","height":24,"left":414,"lineHeight":"1.4","textAlign":"center","top":26,"width":110}},"mobile":{"config":{"hide":true},"styles":{"color":"rgba(26,26,26,1)","fontSize":14,"height":22,"left":270,"lineHeight":"1.4","textAlign":"center","top":22,"width":130}}}},{"id":"l_2107","type":"line","responsive":{"desktop":{"styles":{"borderColor":"rgba(230,232,236,1)","left":0,"top":63,"width":960}},"mobile":{"styles":{"borderColor":"rgba(230,232,236,1)","left":0,"top":60,"width":420}}}}]},{"id":"sec_2108","type":"section","responsive":{"desktop":{"styles":{"background":"rgba(255,255,255,1)","height":8336}},"mobile":{"styles":{"background":"rgba(255,255,255,1)","height":11447}}},"children":[{"id":"t_2109","type":"text-block","specials":{"text":"<a href=\"https://www.dijaedadula.com/blog\" style=\"color:rgba(0,122,102,1);text-decoration:underline\">Blog</a> · AI agents and workflows"},"responsive":{"desktop":{"styles":{"color":"rgba(120,120,120,1)","fontSize":14,"fontWeight":"400","height":25,"left":160,"lineHeight":"1.5","textAlign":"left","top":64,"width":640}},"mobile":{"styles":{"color":"rgba(120,120,120,1)","fontSize":13,"fontWeight":"400","height":24,"left":20,"lineHeight":"1.5","textAlign":"left","top":48,"width":380}}}},{"id":"t_2110","type":"text-block","specials":{"tag":"h1","text":"AI Chatbot Liability: What the Air Canada Ruling Means for Your Business"},"responsive":{"desktop":{"styles":{"color":"rgba(26,26,26,1)","fontSize":42,"fontWeight":"800","height":154,"left":160,"lineHeight":"1.18","textAlign":"left","top":105,"width":640}},"mobile":{"styles":{"color":"rgba(26,26,26,1)","fontSize":30,"fontWeight":"800","height":147,"left":20,"lineHeight":"1.18","textAlign":"left","top":84,"width":380}}}},{"id":"t_2111","type":"text-block","specials":{"text":"A website chatbot invented a refund rule and the airline had to pay. What the tribunal decided, why, and how to make sure your chatbot only promises what your business would."},"responsive":{"desktop":{"styles":{"color":"rgba(85,85,85,1)","fontSize":21,"fontWeight":"400","height":98,"left":160,"lineHeight":"1.5","textAlign":"left","top":277,"width":640}},"mobile":{"styles":{"color":"rgba(85,85,85,1)","fontSize":18,"fontWeight":"400","height":139,"left":20,"lineHeight":"1.5","textAlign":"left","top":245,"width":380}}}},{"id":"t_2112","type":"text-block","specials":{"text":"By <a href=\"https://www.dijaedadula.com/home\" style=\"color:rgba(0,122,102,1);text-decoration:underline\">Dijae Dadula</a> · November 13, 2026 · 8 min read"},"responsive":{"desktop":{"styles":{"color":"rgba(120,120,120,1)","fontSize":14,"fontWeight":"400","height":25,"left":160,"lineHeight":"1.5","textAlign":"left","top":393,"width":640}},"mobile":{"styles":{"color":"rgba(120,120,120,1)","fontSize":13,"fontWeight":"400","height":24,"left":20,"lineHeight":"1.5","textAlign":"left","top":398,"width":380}}}},{"id":"eb_2120","type":"editor-blog","specials":{"html":"<div class='dd-article dd-c'>\n<figure class='dd-fig'><div class='dd-shot' style='aspect-ratio:16/9'><img src='https://statics.pancake.vn/web-media-264/3b/06/1c/a9/64dd359edf430ed40b3cc2fd41e7e328dd36edcdfc5d93b46d6fdf7d.png' alt='Dark paper-cut illustration of a balance scale weighing a friendly chatbot speech bubble against a storefront and a checked policy document' width='1536' height='864' loading='lazy'></div></figure>\n<div class='dd-scene'><span class='dd-note-label'>Picture this · illustrative</span>\n<p>A customer asks your website chatbot whether a discount still applies after they have paid. The chatbot says yes, confidently, and even explains the steps. Your policy page says no. The customer books, follows the steps, and asks for the discount. Your team points to the policy page. The customer points to the chat transcript.</p></div>\n<p class='dd-plain'>Chatbot liability means <mark>your business is responsible for what your chatbot tells customers, the same as any other page on your website.</mark></p>\n<div class='dd-words'><span><b>Misrepresentation</b> a false statement someone relies on</span><span><b>Duty of care</b> the obligation to take reasonable care with information</span><span><b>Reliance</b> the customer acted on what they were told</span><span><b>Source of truth</b> the one page or document your answers must match</span></div>\n<nav class='dd-toc' aria-label='Table of contents'>\n<p class='dd-toc-title'>Questions in this guide</p>\n<ol>\n<li><a href='#what-happened'>What happened in the Air Canada chatbot case?</a></li>\n<li><a href='#why'>Why was the airline held responsible?</a></li>\n<li><a href='#you'>Does this apply to your business?</a></li>\n<li><a href='#where'>Where do chatbots usually go wrong?</a></li>\n<li><a href='#protect'>How do you protect your business?</a></li>\n<li><a href='#try'>What can you set up today?</a></li>\n</ol>\n</nav>\n<h2 id='what-happened'>What happened in the Air Canada chatbot case?</h2>\n<p class='dd-short'><b>Short answer:</b> a website chatbot described a refund rule that did not exist, a customer relied on it, and a Canadian tribunal ordered the airline to pay.</p>\n<p>In <i>Moffatt v. Air Canada</i>, decided by British Columbia's Civil Resolution Tribunal on February 14, 2024, a customer asked the airline's website chatbot about bereavement fares. The chatbot told him the airline offered reduced bereavement fares and that, if he had already travelled, he could submit his ticket for a reduced rate within 90 days of the date the ticket was issued.</p>\n<p>The airline's own “Bereavement travel” page, which the chatbot linked to, said the opposite: the policy does not apply to requests made after travel is completed. The customer booked full-price tickets, travelled, applied for the partial refund within the 90 days, and was refused.</p>\n<p>The tribunal found the airline liable for negligent misrepresentation and ordered it to pay $650.88 in damages, plus $36.14 in pre-judgment interest and $125 in tribunal fees, for a total of $812.02. The amount is small. The principle is not.</p>\n<figure class='dd-fig'>\n<svg class='dk' viewBox='0 0 640 260' role='img' aria-labelledby='sc1t sc1d' xmlns='http://www.w3.org/2000/svg'>\n<title id='sc1t'>How a wrong chatbot answer became a liability</title>\n<desc id='sc1d'>A dashed path runs through five stops: the customer asks, the chatbot answers with the wrong rule, the customer relies on it and books, the refund is refused, and the tribunal holds the company responsible. The step where the chatbot contradicts the policy page is highlighted.</desc>\n<defs><linearGradient id='sc1bg' x1='0' y1='0' x2='1' y2='1'><stop offset='0' stop-color='#1f2224'/><stop offset='1' stop-color='#0a0b0c'/></linearGradient>\n<pattern id='sc1g' width='16' height='16' patternUnits='userSpaceOnUse'><circle cx='2' cy='2' r='1' fill='#2a2e31'/></pattern></defs>\n<rect x='0' y='0' width='640' height='260' rx='14' fill='url(#sc1bg)'/>\n<rect x='0' y='0' width='640' height='260' rx='14' fill='url(#sc1g)'/>\n<text x='24' y='34' class='svg-k'>FROM ONE ANSWER TO A RULING</text>\n<path d='M70 150 C 120 90, 170 90, 200 130 S 290 190, 330 140 S 420 90, 460 130 S 540 180, 580 140' fill='none' stroke='#3fbfa6' stroke-width='3' stroke-dasharray='8 7' stroke-linecap='round'/>\n<circle cx='70' cy='150' r='12' fill='#17191b' stroke='#3fbfa6' stroke-width='2.5'/>\n<text x='40' y='190' class='svg-t'>Asks</text><text x='30' y='208' class='svg-s'>fare question</text>\n<rect x='150' y='56' width='128' height='26' rx='4' fill='#3fbfa6' opacity='0.3'/>\n<circle cx='200' cy='128' r='12' fill='#10302a' stroke='#3fbfa6' stroke-width='3'/>\n<text x='158' y='74' class='svg-t'>Wrong rule</text><text x='160' y='104' class='svg-s'>chatbot vs policy</text>\n<circle cx='330' cy='140' r='12' fill='#17191b' stroke='#3fbfa6' stroke-width='2.5'/>\n<text x='296' y='186' class='svg-t'>Relies</text><text x='292' y='204' class='svg-s'>books, travels</text>\n<circle cx='460' cy='128' r='12' fill='#17191b' stroke='#3fbfa6' stroke-width='2.5'/>\n<text x='426' y='64' class='svg-t'>Refused</text><text x='410' y='82' class='svg-s'>policy page says no</text>\n<circle cx='580' cy='140' r='12' fill='#10302a' stroke='#3fbfa6' stroke-width='3'/>\n<text x='530' y='186' class='svg-t'>Liable</text><text x='514' y='204' class='svg-s'>company pays</text>\n<text x='24' y='242' class='svg-hand'>the bot spoke for the business</text>\n</svg>\n<figcaption><b>Sketch 1.</b> The chain the tribunal followed: a wrong answer, reasonable reliance, a refusal, and a business held responsible for its own website.</figcaption>\n</figure>\n<h2 id='why'>Why was the airline held responsible?</h2>\n<p class='dd-short'><b>Short answer:</b> the chatbot was part of the airline's website, the airline had a duty to take reasonable care that it was accurate, and the customer reasonably relied on it.</p>\n<p>The airline argued that it could not be held liable for information provided by its agents, servants or representatives, including a chatbot. The tribunal called that a remarkable submission and answered it in one line: it should be obvious that the company is responsible for all the information on its website. It made no difference whether the information came from a static page or a chatbot.</p>\n<p>Three findings carried the decision:</p>\n<ul>\n<li><b>A duty of care existed.</b> The airline and its customer had a commercial relationship, so the airline had to take reasonable care that its representations were accurate.</li>\n<li><b>Reasonable care was not taken.</b> The airline did not show any steps it took to make sure the chatbot was accurate.</li>\n<li><b>The reliance was reasonable.</b> A customer has no reason to think one part of a company's website is accurate and another part is not, and should not be expected to double-check the chatbot against other pages.</li>\n</ul>\n<div class='dd-myth'>\n<div class='dd-m'><span class='dd-lab'>Myth</span><p>A disclaimer that “AI can make mistakes” moves the responsibility to the customer.</p></div>\n<div class='dd-r'><span class='dd-lab'>Reality</span><p>The ruling treated the chatbot as the company's own information. A disclaimer may help set expectations, but it is not a substitute for accurate answers.</p></div>\n</div>\n<h2 id='you'>Does this apply to your business?</h2>\n<p class='dd-short'><b>Short answer:</b> the decision is from one Canadian tribunal, but the principle behind it is the one customers, regulators and courts tend to apply everywhere: your channel, your answer.</p>\n<p>A small-claims tribunal decision does not bind courts in other provinces or countries, and laws differ between the Philippines, the US, Canada and elsewhere. I am not a lawyer, and you should ask one about your own exposure. What the case shows is how a decision-maker reasons about a chatbot: not as a separate thing with its own responsibility, but as part of the business that deployed it.</p>\n<p>That reasoning matters most when your chatbot talks about money, eligibility or obligations: prices, discounts, refunds, warranties, delivery promises, appointment policies, or anything regulated. Those are the answers customers act on.</p>\n<div class='dd-sticky'><span class='dd-note-label'>Dijae's rule</span><p>If you would not let a new hire promise it without checking, your chatbot should not promise it either.</p></div>\n<h2 id='where'>Where do chatbots usually go wrong?</h2>\n<p class='dd-short'><b>Short answer:</b> when they answer policy questions from memory instead of from one approved source, and when nobody tests the questions that cost money.</p>\n<p>The pattern in the Air Canada case is common: the right policy existed and was even linked, but the chatbot's answer did not match it. The risky answers usually fall into a few groups.</p>\n<div class='dd-table-wrap'><table>\n<thead><tr><th>Risk area</th><th>What goes wrong</th><th>What to do instead</th></tr></thead>\n<tbody>\n<tr><td>Refunds and cancellations</td><td>The chatbot fills a gap with a plausible rule</td><td>Answer only from the published policy, quoted or linked</td></tr>\n<tr><td>Prices and promos</td><td>Old promos stay in the knowledge base</td><td>Give every promo an end date and remove it on that date</td></tr>\n<tr><td>Eligibility</td><td>The chatbot decides who qualifies</td><td>Collect the facts and let a person confirm</td></tr>\n<tr><td>Delivery and timelines</td><td>It promises dates the team cannot meet</td><td>Give ranges from the operations team, never exact promises</td></tr>\n<tr><td>Regulated advice</td><td>Medical, legal, financial or licensed advice slips in</td><td>Hand off to a qualified person every time</td></tr>\n</tbody></table></div>\n<figure class='dd-fig'>\n<svg class='dk' viewBox='0 0 640 250' role='img' aria-labelledby='sc2t sc2d' xmlns='http://www.w3.org/2000/svg'>\n<title id='sc2t'>One source of truth for policy answers</title>\n<desc id='sc2d'>Before: the chatbot answers from its own memory and drifts away from the policy page. After: the policy page is the single source, the chatbot quotes it and links it, and anything not covered goes to a person.</desc>\n<defs><linearGradient id='sc2bg' x1='0' y1='0' x2='1' y2='1'><stop offset='0' stop-color='#1f2224'/><stop offset='1' stop-color='#0a0b0c'/></linearGradient>\n<pattern id='sc2g' width='16' height='16' patternUnits='userSpaceOnUse'><circle cx='2' cy='2' r='1' fill='#2a2e31'/></pattern></defs>\n<rect x='0' y='0' width='640' height='250' rx='14' fill='url(#sc2bg)'/>\n<rect x='0' y='0' width='640' height='250' rx='14' fill='url(#sc2g)'/>\n<text x='24' y='34' class='svg-k'>BEFORE</text>\n<text x='344' y='34' class='svg-k'>AFTER</text>\n<line x1='320' y1='20' x2='320' y2='230' stroke='#2a2e31' stroke-width='2'/>\n<rect x='30' y='60' width='110' height='46' rx='18' fill='#17191b' stroke='#3a3f43' stroke-width='2.5'/><text x='48' y='88' class='svg-t'>Chatbot</text>\n<rect x='180' y='150' width='116' height='46' rx='10' fill='#17191b' stroke='#3a3f43' stroke-width='2.5'/><text x='194' y='178' class='svg-t'>Policy page</text>\n<path d='M140 84 C 200 84, 230 100, 250 120' fill='none' stroke='#8a8f94' stroke-width='2.5' stroke-dasharray='4 8' stroke-linecap='round'/>\n<text x='30' y='140' class='svg-hand'>answers from memory</text>\n<text x='30' y='220' class='svg-s'>The two drift apart</text>\n<rect x='350' y='56' width='128' height='46' rx='10' fill='#10302a' stroke='#3fbfa6' stroke-width='3'/><text x='364' y='84' class='svg-t'>Policy page</text>\n<rect x='500' y='56' width='110' height='46' rx='18' fill='#17191b' stroke='#3a3f43' stroke-width='2.5'/><text x='518' y='84' class='svg-t'>Chatbot</text>\n<path d='M478 79 L 496 79' stroke='#3fbfa6' stroke-width='3' stroke-dasharray='8 7' stroke-linecap='round'/>\n<rect x='500' y='150' width='110' height='46' rx='18' fill='#17191b' stroke='#3a3f43' stroke-width='2.5'/><text x='520' y='178' class='svg-t'>Person</text>\n<path d='M555 102 L 555 146' stroke='#3fbfa6' stroke-width='3' stroke-dasharray='8 7' stroke-linecap='round'/>\n<rect x='344' y='128' width='140' height='24' rx='4' fill='#3fbfa6' opacity='0.3'/>\n<text x='350' y='145' class='svg-t'>quote it, link it</text>\n<text x='350' y='220' class='svg-s'>Not covered? A person answers</text>\n</svg>\n<figcaption><b>Sketch 2.</b> Make the policy page the single source. The chatbot quotes and links it, and anything it does not cover goes to a person.</figcaption>\n</figure>\n<h2 id='protect'>How do you protect your business?</h2>\n<p class='dd-short'><b>Short answer:</b> give the chatbot one approved source for every money-related answer, test those answers before launch and after every change, and keep a person in the loop for anything the source does not cover.</p>\n<p>None of this is exotic. It is the same discipline you would apply to a new team member who talks to customers:</p>\n<ul>\n<li><b>Ground policy answers.</b> Put refunds, cancellations, prices and promos in one knowledge source the chatbot must use, and tell it to quote or link the policy instead of paraphrasing it. My guide on <a href='https://www.dijaedadula.com/rag-ai-agent-business-knowledge'>grounding an AI agent in your business knowledge</a> shows how.</li>\n<li><b>Write guardrails.</b> Tell the chatbot what it must never promise, and what to say instead. See <a href='https://www.dijaedadula.com/ai-agent-guardrails'>how to stop an AI agent from making things up</a>.</li>\n<li><b>Hand off the hard questions.</b> Eligibility decisions, exceptions and complaints go to a person. The <a href='https://www.dijaedadula.com/ai-chatbot-human-handoff'>human handoff guide</a> covers when and how.</li>\n<li><b>Test the money questions.</b> Build a test set from real customer questions about refunds, prices and promises, and run it before launch and after every change. Use the method in <a href='https://www.dijaedadula.com/how-to-test-an-ai-chatbot'>how to test an AI chatbot</a>.</li>\n<li><b>Keep the transcripts.</b> Review a sample every week, as described in the <a href='https://www.dijaedadula.com/ai-agent-monitoring-weekly-review'>weekly review</a>. If a wrong answer slips through, you want to find it before a customer quotes it back to you.</li>\n</ul>\n<div class='dd-warn'><span class='dd-note-label'>Watch out</span><p>A policy change on your website does not update your chatbot by itself unless it reads that page live. Add “update the chatbot's source” to the checklist for every policy or price change.</p></div>\n<h2 id='try'>What can you set up today?</h2>\n<ol class='dd-try'>\n<li>List the ten questions customers ask that involve money, eligibility or a promise.</li>\n<li>For each one, write down the single page or document that holds the approved answer.</li>\n<li>Ask your chatbot all ten questions and compare each answer with that source, word for word on the numbers and conditions.</li>\n<li>Fix every mismatch in the source the chatbot uses, then add a rule: if the source does not cover it, hand off to a person.</li>\n<li>Put the ten questions in a test sheet and rerun them after every change to prices, policies or the chatbot itself.</li>\n</ol>\n<p><b>How you will know it works</b> (acceptance criteria for the ten money questions):</p>\n<div class='dd-table-wrap'><table>\n<thead><tr><th>Check</th><th>Pass when</th></tr></thead>\n<tbody>\n<tr><td>Accuracy</td><td>10 of 10 answers match the approved source on numbers, dates and conditions</td></tr>\n<tr><td>Linking</td><td>Every policy answer links or quotes the policy page</td></tr>\n<tr><td>Uncovered questions</td><td>Questions outside the source go to a person instead of a guess</td></tr>\n<tr><td>Change control</td><td>The test set is rerun and passes after every policy, price or chatbot change</td></tr>\n<tr><td>Review</td><td>A weekly sample of transcripts is read, and any wrong promise is fixed the same week</td></tr>\n</tbody></table></div>\n<p>An honest limitation: these steps lower the risk of a wrong answer, but no setup makes an AI chatbot perfect, and they do not replace legal advice about your obligations where you operate.</p>\n<h2 id='faq'>Frequently asked questions</h2>\n<h3>Is a business legally responsible for what its chatbot says?</h3>\n<p>In <i>Moffatt v. Air Canada</i> (2024), a Canadian tribunal held the airline responsible for its website chatbot's wrong answer, treating it like any other information on the website. Laws differ by country, so ask a lawyer about your situation, but plan as if your chatbot speaks for you.</p>\n<h3>How much did Air Canada have to pay?</h3>\n<p>$812.02 in total: $650.88 in damages, $36.14 in pre-judgment interest and $125 in tribunal fees. The amount was small; the attention the case received was not.</p>\n<h3>Does an “AI can make mistakes” disclaimer protect my business?</h3>\n<p>Do not rely on it. The tribunal found a customer should not have to double-check one part of a website against another. Accurate, grounded answers protect you far better than a disclaimer.</p>\n<h3>Should my chatbot stop answering policy questions?</h3>\n<p>No. Customers want fast answers about refunds, prices and bookings. Let it answer from one approved source, link the policy, and hand off anything the source does not cover.</p>\n<div class='dd-cta'>\n<p class='dd-cta-title'>Make sure your chatbot says only what you would say</p>\n<p>Want a second pair of eyes on what your chatbot promises customers? <a href='https://www.dijaedadula.com/book'>Book a free AI Automation Blueprint call</a> and we will map your riskiest answers and how to ground them.</p>\n<p>Prefer to learn it step by step? <a href='https://grow.dijaedadula.com/newsletter'>Join the free weekly newsletter</a>.</p>\n</div>\n<h2>References</h2>\n<ol class='dd-refs'>\n<li><a href='https://decisions.civilresolutionbc.ca/crt/crtd/en/525448/1/document.do' target='_blank' rel='noopener'>Moffatt v. Air Canada, 2024 BCCRT 149</a>, Civil Resolution Tribunal of British Columbia, February 14, 2024 (paragraphs 15, 17, 24 to 27, 31 to 32 and 40 to 44).</li>\n<li><a href='https://www.mccarthy.ca/en/insights/blogs/techlex/moffatt-v-air-canada-misrepresentation-ai-chatbot' target='_blank' rel='noopener'>Barry B. Sookman, McCarthy Tétrault TechLex: Moffatt v. Air Canada: A Misrepresentation by an AI Chatbot</a>, February 19, 2024.</li>\n</ol>\n<h2>Keep reading</h2>\n<ul class='dd-more'>\n<li><a href='https://www.dijaedadula.com/ai-agent-guardrails'>How to Stop an AI Agent From Making Things Up</a></li>\n<li><a href='https://www.dijaedadula.com/how-to-test-an-ai-chatbot'>How to Test an AI Chatbot Before It Talks to Your Customers</a></li>\n<li><a href='https://www.dijaedadula.com/ai-chatbot-human-handoff'>When Should an AI Chatbot Hand Off to a Human?</a></li>\n<li><a href='https://www.dijaedadula.com/blog'>See all posts on the blog</a></li>\n</ul>\n</div>\n"},"responsive":{"desktop":{"styles":{"height":7829,"left":160,"top":450,"width":640}},"mobile":{"styles":{"height":10948,"left":20,"top":450,"width":380}}}},{"id":"h_css2121","type":"html-box","specials":{"html":"&lt;style&gt;.dd-article ul{list-style:disc outside !important}.dd-article ol{list-style:decimal outside !important}.dd-article li{display:list-item !important}.dd-article ul ul{list-style:circle outside !important}&lt;/style&gt;"},"responsive":{"desktop":{"styles":{"height":1,"left":160,"top":8326,"width":1}},"mobile":{"styles":{"height":1,"left":20,"top":11437,"width":1}}}}]},{"id":"sec_2141","type":"section","responsive":{"desktop":{"styles":{"background":"rgba(247,248,250,1)","height":402}},"mobile":{"styles":{"background":"rgba(247,248,250,1)","height":508}}},"children":[{"id":"t_2142","type":"text-block","specials":{"tag":"h2","text":"Get one practical idea like this every week"},"responsive":{"desktop":{"styles":{"color":"rgba(26,26,26,1)","fontSize":26,"fontWeight":"800","height":69,"left":160,"lineHeight":"1.25","textAlign":"left","top":56,"width":640}},"mobile":{"styles":{"color":"rgba(26,26,26,1)","fontSize":22,"fontWeight":"800","height":59,"left":20,"lineHeight":"1.25","textAlign":"left","top":40,"width":380}}}},{"id":"t_2143","type":"text-block","specials":{"text":"Join the free newsletter on AI agents, automation and turning your skills into income. Prefer video? Watch the walkthroughs on <a href=\"https://www.youtube.com/c/DijaeDadulaPRO\" style=\"color:rgba(0,122,102,1);text-decoration:underline\">YouTube</a>."},"responsive":{"desktop":{"styles":{"color":"rgba(85,85,85,1)","fontSize":17,"fontWeight":"400","height":59,"left":160,"lineHeight":"1.6","textAlign":"left","top":137,"width":640}},"mobile":{"styles":{"color":"rgba(85,85,85,1)","fontSize":16,"fontWeight":"400","height":107,"left":20,"lineHeight":"1.6","textAlign":"left","top":109,"width":380}}}},{"id":"b_2144","type":"button","specials":{"text